      "parameters": {
        "jsCode": "\nconst items =\n  $input.all()\n    .map(i => i.json)\n    .filter(Boolean);\n\nif (!items.length) {\n  throw new Error(\n    'No batch summaries were produced.'\n  );\n}\n\nconst first = items[0];\n\nconst signatures =\n  [...new Set(\n    items\n      .map(x => x.target?.selected_cluster_signature)\n      .filter(Boolean)\n  )];\n\nif (signatures.length > 1) {\n  throw new Error(\n    `Batch summaries belong to multiple cluster signatures: ${signatures.join(', ')}`\n  );\n}\n\nconst metrics = [];\n\nconst extractionErrors = [];\nconst batchDiagnostics = [];\n\nlet queryCount = 0;\nlet analyzedSeriesCount = 0;\nlet skippedPoints = 0;\n\nfor (const item of items) {\n  const batch =\n    item.batch || {\n      id: 'unknown',\n      type: 'unknown',\n      label: 'unknown'\n    };\n\n  const batchMetrics =\n    Array.isArray(item.metrics)\n      ? item.metrics\n      : [];\n\n  for (const metric of batchMetrics) {\n    metrics.push({\n      ...metric,\n      analysis_batch: {\n        id: batch.id,\n        type: batch.type,\n        label: batch.label,\n        replica_set:\n          batch.replica_set || null\n      }\n    });\n  }\n\n  const ext =\n    item.extraction || {};\n\n  queryCount +=\n    Number(ext.query_count || 0);\n\n  analyzedSeriesCount +=\n    Number(ext.analyzed_series_count || 0);\n\n  skippedPoints +=\n    Number(\n      ext.non_numeric_or_null_points_skipped || 0\n    );\n\n  const errs =\n    Array.isArray(ext.extraction_errors)\n      ? ext.extraction_errors\n      : [];\n\n  for (const err of errs) {\n    extractionErrors.push({\n      batch_id: batch.id,\n      batch_type: batch.type,\n      ...err\n    });\n  }\n\n  batchDiagnostics.push({\n    batch_id: batch.id,\n    batch_type: batch.type,\n    label: batch.label,\n    replica_set:\n      batch.replica_set || null,\n    service_count:\n      Number(batch.service_count || 0),\n    node_count:\n      Number(batch.node_count || 0),\n    query_count:\n      Number(ext.query_count || 0),\n    analyzed_series_count:\n      Number(ext.analyzed_series_count || 0),\n    extraction_error_count:\n      errs.length\n  });\n}\n\nmetrics.sort((a, b) => {\n  const ba =\n    String(\n      a.analysis_batch?.id || ''\n    );\n\n  const bb =\n    String(\n      b.analysis_batch?.id || ''\n    );\n\n  if (ba !== bb) {\n    return ba.localeCompare(bb);\n  }\n\n  const ca =\n    String(a.category || '');\n\n  const cb =\n    String(b.category || '');\n\n  if (ca !== cb) {\n    return ca.localeCompare(cb);\n  }\n\n  return String(\n    a.display_name || ''\n  ).localeCompare(\n    String(b.display_name || '')\n  );\n});\n\nconst inventory =\n  first.metric_inventory || {};\n\nreturn [{\n  json: {\n    report_type:\n      first.report_type,\n\n    target:\n      first.target,\n\n    requested_period:\n      first.requested_period,\n\n    metric_inventory:\n      inventory,\n\n    batch_architecture: {\n      enabled: true,\n      batch_count:\n        items.length,\n\n      replica_set_batch_count:\n        items.filter(\n          x =>\n            x.batch?.type ===\n            'replica_set'\n        ).length,\n\n      config_server_batch_count:\n        items.filter(\n          x =>\n            x.batch?.type ===\n            'config_server_replica_set'\n        ).length,\n\n      mongos_batch_count:\n        items.filter(\n          x =>\n            x.batch?.type ===\n            'mongos'\n        ).length,\n\n      cluster_metadata_batch_count:\n        items.filter(\n          x =>\n            x.batch?.type ===\n            'cluster_metadata'\n        ).length,\n\n      raw_time_series_cross_batch_merge:\n        false,\n\n      aggregation_level:\n        'per-series statistical summaries only',\n\n      batches:\n        batchDiagnostics\n    },\n\n    extraction: {\n      query_count:\n        queryCount,\n\n      analyzed_series_count:\n        analyzedSeriesCount,\n\n      non_numeric_or_null_points_skipped:\n        skippedPoints,\n\n      extraction_errors:\n        extractionErrors,\n\n      performance_mode: {\n        batch_isolation: true,\n        raw_points_discarded_before_cluster_merge: true,\n        repeated_percentile_sorts: false,\n        hourly_bucket_profiles: false,\n        highest_point_arrays: false,\n        dynamic_raw_sharding_range_queries: false\n      }\n    },\n\n    metrics\n  }\n}];\n"
