      "parameters": {
        "jsCode": "const response = $json;\n\nconst stateNames = {\n  0: 'STARTUP',\n  1: 'PRIMARY',\n  2: 'SECONDARY',\n  3: 'RECOVERING',\n  5: 'STARTUP2',\n  6: 'UNKNOWN',\n  7: 'ARBITER',\n  8: 'DOWN',\n  9: 'ROLLBACK',\n  10: 'REMOVED'\n};\n\nfunction clean(v) {\n  return v === undefined || v === null ? '' : String(v).trim();\n}\nfunction num(v) {\n  if (v === null || v === undefined) return null;\n  if (typeof v === 'string' && v.trim() === '') return null;\n  const n = Number(v);\n  return Number.isFinite(n) ? n : null;\n}\nfunction parts(field) {\n  const s = clean(\n    field?.config?.displayNameFromDS ||\n    field?.config?.displayName ||\n    field?.name ||\n    ''\n  );\n  return s.includes('|||') ? s.split('|||').map(clean) : [];\n}\nfunction lastNumeric(frame, fieldIndex) {\n  const vals = frame?.data?.values?.[fieldIndex] || [];\n  for (let i = vals.length - 1; i >= 0; i--) {\n    const n = num(vals[i]);\n    if (n !== null) return n;\n  }\n  return null;\n}\n\nconst services = new Map();\n\nfunction upsert(attrs) {\n  const node = clean(attrs.node_name);\n  const service = clean(attrs.service_name);\n\n  if (!node || !service) return;\n\n  const key = `${node}|||${service}`;\n  const current = services.get(key) || {\n    node_name: node,\n    service_name: service,\n    cl_role: null,\n    cluster_role: null,\n    pmm_cluster: null,\n    replica_set: null,\n    state_code: null,\n    state_name: null,\n    environment: null\n  };\n\n  if (clean(attrs.cl_role)) current.cl_role = clean(attrs.cl_role);\n  if (clean(attrs.cluster_role)) current.cluster_role = clean(attrs.cluster_role);\n  if (clean(attrs.pmm_cluster)) current.pmm_cluster = clean(attrs.pmm_cluster);\n  if (clean(attrs.environment)) current.environment = clean(attrs.environment);\n\n  const rs =\n    clean(attrs.replication_set) ||\n    clean(attrs.rs_nm) ||\n    clean(attrs.set);\n\n  if (rs) current.replica_set = rs;\n\n  if (attrs.state_code !== null && attrs.state_code !== undefined) {\n    current.state_code = attrs.state_code;\n    current.state_name =\n      stateNames[attrs.state_code] || `STATE_${attrs.state_code}`;\n  }\n\n  services.set(key, current);\n}\n\nfunction processFrames(refId, stateMode) {\n  const frames = response?.results?.[refId]?.frames || [];\n\n  for (const frame of frames) {\n    const fields = frame?.schema?.fields || [];\n\n    for (let fieldIndex = 0; fieldIndex < fields.length; fieldIndex++) {\n      const field = fields[fieldIndex];\n      if (field?.type !== 'number') continue;\n\n      const labels =\n        field?.labels ||\n        field?.config?.labels ||\n        {};\n\n      const p = parts(field);\n\n      upsert({\n        node_name: labels.node_name || p[0],\n        service_name: labels.service_name || p[1],\n        cl_role: labels.cl_role || p[2],\n        cluster_role: labels.cluster_role || p[3],\n        pmm_cluster: labels.cluster || p[4],\n        rs_nm: labels.rs_nm || p[5],\n        replication_set: labels.replication_set || p[6],\n        set: labels.set || p[7],\n        state_code:\n          stateMode\n            ? lastNumeric(frame, fieldIndex)\n            : num(labels.rs_state ?? labels.state ?? p[8] ?? p[9]),\n        environment:\n          labels.environment ||\n          (stateMode ? p[8] : p[10])\n      });\n    }\n  }\n}\n\nprocessFrames('MONGO_UP', false);\nprocessFrames('REPL_STATE', true);\n\nconst allServices = [...services.values()]\n  .sort((a,b) =>\n    a.node_name.localeCompare(b.node_name) ||\n    a.service_name.localeCompare(b.service_name)\n  );\n\nconst mongos = allServices.filter(s => {\n  const role =\n    clean(s.cl_role || s.cluster_role).toLowerCase();\n  return role === 'mongos';\n});\n\nif (!mongos.length) {\n  throw new Error(\n    'No mongos router was discovered from mongodb_up cl_role/cluster_role labels. ' +\n    'Without a mongos anchor the PMM-only sharded-cluster workflow cannot assemble shard membership safely.'\n  );\n}\n\nconst selectionMap = {};\nconst