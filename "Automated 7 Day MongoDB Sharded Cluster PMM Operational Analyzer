    {
      "parameters": {
        "jsCode": "const data = $json;\nconst metrics = Array.isArray(data.metrics) ? data.metrics : [];\n\nconst valid = metrics.filter(m => !m.error);\nconst poor = valid.filter(m => m.data_quality?.status === 'poor');\nconst warning = valid.filter(m => m.data_quality?.status === 'warning');\n\nconst errors = [\n  ...(Array.isArray(data.extraction?.extraction_errors)\n    ? data.extraction.extraction_errors\n    : []),\n  ...metrics.filter(m => m.error).map(m => ({\n    ref_id: m.ref_id,\n    metric_key: m.metric_key,\n    error: m.error\n  }))\n];\n\nlet status = 'reliable';\nconst reasons = [];\n\nif (!data.metric_inventory?.selected_query_count) {\n  status = 'not_reliable';\n  reasons.push('No curated/dynamic MongoDB cluster metrics were available.');\n} else if (!valid.length) {\n  status = 'not_reliable';\n  reasons.push('No valid numeric PMM time-series were available.');\n} else if (poor.length) {\n  status = 'needs_validation';\n\n  reasons.push(\n    `${poor.length} analyzed series have poor sampling completeness after accounting for the configured maxDataPoints query-resolution limit.`\n  );\n\n  if (errors.length) {\n    reasons.push(\n      `${errors.length} query/extraction error(s) were also detected.`\n    );\n  }\n} else if (errors.length || warning.length) {\n  status = 'usable_with_caution';\n\n  if (warning.length) {\n    reasons.push(\n      `${warning.length} series contain sampling gaps or reduced completeness.`\n    );\n  }\n\n  if (errors.length) {\n    reasons.push(\n      `${errors.length} query/extraction error(s) were detected; unaffected metric families remain usable.`\n    );\n  }\n} else {\n  reasons.push('All analyzed time-series passed the workflow data-quality checks.');\n}\n\nconst expectedServices =\n  Number(data.target?.expected_service_count || 0);\n\nconst batchArchitecture =\n  data.batch_architecture || null;\n\nif (!batchArchitecture?.enabled) {\n  status = 'needs_validation';\n  reasons.push(\n    'Cluster batch architecture metadata is missing.'\n  );\n} else {\n  const expectedShardBatches =\n    Array.isArray(data.target?.selected_shard_names)\n      ? data.target.selected_shard_names.length\n      : 0;\n\n  if (\n    expectedShardBatches > 0 &&\n    Number(batchArchitecture.replica_set_batch_count || 0) <\n      expectedShardBatches\n  ) {\n    status = 'needs_validation';\n    reasons.push(\n      `Expected ${expectedShardBatches} data-shard batch(es), but only ${Number(batchArchitecture.replica_set_batch_count || 0)} completed.`\n    );\n  }\n}\n\nconst preservedServices =\n  Array.isArray(data.target?.cluster_services)\n    ? data.target.cluster_services\n    : [];\n\nif (expectedServices > 0 && preservedServices.length === 0) {\n  status = 'needs_validation';\n  reasons.push('Cluster service metadata was not preserved into the analysis payload.');\n}\n\nif (!data.target?.selected_mongos?.service_name) {\n  status = 'needs_validation';\n  reasons.push('Selected mongos anchor is missing from the analysis payload.');\n}\n\nif (!data.target?.shard_membership_available) {\n  reasons.push(\n    'PMM shard membership could not be assembled from mongodb_shards_collection_chunks_count; cluster analysis is limited to the selected mongos unless the shards collector is enabled.'\n  );\n}\n\nreturn [{\n  json: {\n    ...data,\n    data_quality_gate: {\n      status,\n      customer_report_eligible:\n        status === 'reliable' || status === 'usable_with_caution',\n      valid_series_count: valid.length,\n      warning_series_count: warning.length,\n      poor_series_count: poor.length,\n      error_count: errors.length,\n\n      error_details:\n        errors.slice(0, 20),\n\n      query_resolution_note:\n        'Seven-day completeness uses an effective interval aligned to the maxDataPoints limit so intentional query downsampling is not treated as missing scrapes.',\n\n      selected_query_count:\n        data.metric_inventory?.selected_query_count || 0,\n      discovered_mongodb_metric_count:\n        data.metric_inventory?.mongodb_metric_count || 0,\n      discovered_node_metric_count:\n        data.metric_inventory?.node_metric_count || 0,\n      expected_service_count: expectedServices,\n      preserved_service_count: preservedServices.length,\n      reasons\n    }\n  }\n}];"
