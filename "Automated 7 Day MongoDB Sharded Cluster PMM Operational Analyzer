        "jsCode": "const prepared = $('Prepare Cluster Report Input').first().json;\n\nfunction nonEmptyString(v) {\n  return typeof v === 'string' && v.trim().length > 0\n    ? v.trim()\n    : null;\n}\n\nfunction get(obj, path) {\n  let cur = obj;\n  for (const key of path) {\n    if (cur == null) return null;\n    cur = cur[key];\n  }\n  return cur;\n}\n\n// n8n/LangChain/Gemini output shape differs depending on whether the\n// Agent or the Chat Model result is surfaced. Support all common forms,\n// including the exact shape observed:\n// response.generations[0][0].text\nconst candidates = [\n  $json.output,\n  $json.text,\n  $json.response,\n\n  get($json, ['response', 'generations', 0, 0, 'text']),\n  get($json, ['generations', 0, 0, 'text']),\n\n  get($json, ['response', 'candidates', 0, 'content', 'parts', 0, 'text']),\n  get($json, ['candidates', 0, 'content', 'parts', 0, 'text']),\n\n  get($json, ['message', 'content']),\n  get($json, ['content'])\n];\n\nlet aiText = null;\n\nfor (const candidate of candidates) {\n  const s = nonEmptyString(candidate);\n  if (s) {\n    aiText = s;\n    break;\n  }\n\n  // Some LangChain message content is an array of content blocks.\n  if (Array.isArray(candidate)) {\n    const joined = candidate\n      .map(x => {\n        if (typeof x === 'string') return x;\n        if (x && typeof x.text === 'string') return x.text;\n        return '';\n      })\n      .filter(Boolean)\n      .join('\\n')\n      .trim();\n\n    if (joined) {\n      aiText = joined;\n      break;\n    }\n  }\n}\n\nconst hasAiError = Boolean($json.error);\nconst useAi = !hasAiError && Boolean(aiText);\n\nconst fallbackReason = hasAiError\n  ? 'AI node returned an error'\n  : 'AI node returned no usable report text';\n\nconst report = useAi\n  ? aiText\n  : `> **Generation mode:** Deterministic fallback — ${fallbackReason}. The metric analysis below is complete, but AI narrative interpretation was unavailable for this execution.\\n\\n${prepared.fallback_m