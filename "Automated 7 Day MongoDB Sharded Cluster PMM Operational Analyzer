    {
      "parameters": {
        "jsCode": "const cfg = $json;\n\nconst intervalMs = Number(cfg.sampling_interval_ms || 300000);\nconst lookbackDays = Number(cfg.lookback_days || 7);\n\n// Align the end to a completed 5-minute boundary so repeated runs are\n// statistically comparable and do not include a partial latest bucket.\nconst nowMs = Date.now();\nconst toMs = Math.floor(nowMs / intervalMs) * intervalMs;\nconst fromMs = toMs - lookbackDays * 24 * 60 * 60 * 1000;\n\nreturn [\n  {\n    json: {\n      ...cfg,\n      from_ms: String(fromMs),\n      to_ms: String(toMs),\n      from_iso: new Date(fromMs).toISOString(),\n      to_iso: new Date(toMs).toISOString()\n    }\n  }\n];"
      },
