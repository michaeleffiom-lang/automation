        "jsCode": "const cfg = $json;\n\nfunction esc(v) {\n  return String(v ?? '')\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\n/g, '');\n}\n\nconst selectedService =\n  esc(cfg.selected_mongos?.service_name);\n\nconst allMongosRegex =\n  esc(cfg.all_mongos_service_regex);\n\nif (!selectedService) {\n  throw new Error('selected_mongos.service_name is required.');\n}\n\nconst queries = [\n  {\n    expr:\n      `count by (__name__) (` +\n      `{service_name=\"${selectedService}\",__name__=~\"mongodb_.+\"}` +\n      `)`,\n    format: 'time_series',\n    instant: true,\n    range: false,\n    legendFormat: '{{__name__}}',\n    refId: 'MONGOS_METRICS',\n    datasource: {\n      type: 'prometheus',\n      uid: cfg.prometheus_datasource_uid\n    },\n    datasourceId: Number(cfg.prometheus_datasource_id || 1),\n    intervalMs: Number(cfg.sampling_interval_ms || 300000),\n    maxDataPoints: 5000\n  },\n  {\n    expr:\n      `max by (service_name,node_name,shard) (` +\n      `mongodb_shards_collection_chunks_count{service_name=~\"${allMongosRegex}\"}` +\n      `)`,\n    format: 'time_series',\n    instant: true,\n    range: false,\n    legendFormat: '{{service_name}}|||{{node_name}}|||{{shard}}',\n    refId: 'SHARD_MEMBERSHIP',\n    datasource: {\n      type: 'prometheus',\n      uid: cfg.prometheus_datasource_uid\n    },\n    datasourceId: Number(cfg.prometheus_datasource_id || 1),\n    intervalMs: Number(cfg.sampling_interval_ms || 300000),\n    maxDataPoints: 5000\n  }\n];\n\nreturn [{\n  json: {\n    ...cfg,\n    discovery_url:\n      `${String(cfg.pmm_base_url).replace(/\\/$/, '')}` +\n      '/graph/api/ds/query?ds_type=prometheus&requestId=MONGOMONGOSANCHOR',\n    discovery_body: {\n      queries,\n      from: cfg.from_ms,\n      to: cfg.to_ms\n    }\n  }\n}];"
