        "jsCode": "const response = $json;\nconst cfg = $('Build Cluster MongoDB Metric Discovery').first().json;\n\nfunction clean(v) {\n  return v === undefined || v === null ? '' : String(v).trim();\n}\nfunction parts(field) {\n  const s = clean(\n    field?.config?.displayNameFromDS ||\n    field?.config?.displayName ||\n    field?.name ||\n    ''\n  );\n  return s.includes('|||') ? s.split('|||').map(clean) : [];\n}\nfunction escapeRegex(value) {\n  return String(value).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\n// Escape a completed regex for use inside a PromQL/MetricsQL\n// quoted string. A regex fragment such as \"\\.\" must be sent as \"\\\\.\"\n// inside the PromQL string literal.\nfunction promqlString(value) {\n  return String(value ?? '')\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\n/g, '');\n}\n\n\nconst membershipByService = new Map();\nconst frames =\n  response?.results?.SHARD_MEMBERSHIP?.frames || [];\n\nfor (const frame of frames) {\n  const fields = frame?.schema?.fields || [];\n\n  for (const field of fields) {\n    if (field?.type !== 'number') continue;\n\n    const labels =\n      field?.labels ||\n      field?.config?.labels ||\n      {};\n\n    const p = parts(field);\n\n    const service =\n      clean(labels.service_name || p[0]);\n\n    const node =\n      clean(labels.node_name || p[1]);\n\n    const shard =\n      clean(labels.shard || p[2]);\n\n    if (!service || !shard) continue;\n\n    if (!membershipByService.has(service)) {\n      membershipByService.set(service, {\n        service_name: service,\n        node_name: node,\n        shards: new Set()\n      });\n    }\n\n    membershipByService.get(service).shards.add(shard);\n  }\n}\n\nconst selectedMongosService =\n  cfg.selected_mongos?.service_name;\n\nconst selectedMembership =\n  membershipByService.get(selectedMongosService);\n\nconst selectedShards =\n  selectedMembership\n    ? [...selectedMembership.shards].sort()\n    : [];\n\nconst signature =\n  selectedShards.join('|||');\n\nconst matchingMongosServices = [];\n\nif (selectedShards.length) {\n  for (const entry of membershipByService.values()) {\n    const sig = [...entry.shards].sort().join('|||');\n    if (sig === signature) {\n      matchingMongosServices.push(entry.service_name);\n    }\n  }\n}\n\nif (!matchingMongosServices.includes(selectedMongosService)) {\n  matchingMongosServices.push(selectedMongosService);\n}\n\nconst catalog =\n  Array.isArray(cfg.all_catalog_services)\n    ? cfg.all_catalog_services\n    : [];\n\nconst selectedShardSet = new Set(selectedShards);\n\nconst shardMembers =\n  selectedShards.length\n    ? catalog.filter(s =>\n        s.replica_set &&\n        selectedShardSet.has(s.replica_set)\n      )\n    : [];\n\nconst mongosCatalogServices =\n  catalog.filter(s =>\n    matchingMongosServices.includes(s.service_name)\n  );\n\n// Include config-server members only when PMM/exporter explicitly labels\n// them as configsvr/config server. Do not infer config-server identity\n// merely because a replica set is not present in the shard list.\nconst configServerCatalogServices =\n  catalog.filter(s => {\n    const role =\n      String(s.cl_role || s.cluster_role || '')\n        .toLowerCase()\n        .replace(/[ _-]/g, '');\n\n    return role === 'configsvr' || role === 'configserver';\n  });\n\nconst clusterServicesMap = new Map();\n\nfor (const svc of [\n  ...mongosCatalogServices,\n  ...shardMembers,\n  ...configServerCatalogServices\n]) {\n  clusterServicesMap.set(\n    `${svc.node_name}|||${svc.service_name}`,\n    svc\n  );\n}\n\nconst clusterServices =\n  [...clusterServicesMap.values()];\n\nconst serviceNames =\n  [...new Set(clusterServices.map(x => x.service_name).filter(Boolean))];\n\nconst nodeNames =\n  [...new Set(clusterServices.map(x => x.node_name).filter(Boolean))];\n\nif (!serviceNames.length) {\n  serviceNames.push(selectedMongosService);\n}\nif (!nodeNames.length && cfg.selected_mongos?.node_name) {\n  nodeNames.push(cfg.selected_mongos.node_name);\n}\n\nconst serviceRegex =\n  `^(?:${serviceNames.map(escapeRegex).join('|')})$`;\n\nconst nodeRegex =\n  `^(?:${nodeNames.map(escapeRegex).join('|')})$`;\n\n// Raw regexes are retained in workflow metadata for later builders.\n// The immediate PromQL query must use string-literal-safe versions.\nconst serviceRegexPromQL = promqlString(serviceRegex);\nconst nodeRegexPromQL = promqlString(nodeRegex);\n\nconst replicaSets =\n  [...new Set(\n    shardMembers\n      .map(x => x.replica_set)\n      .filter(Boolean)\n  )].sort();\n\nconst clusterSignature =\n  selectedShards.length\n    ? `mongos:${selectedMongosService}|shards:${selectedShards.join(',')}`\n    : `mongos:${selectedMongosService}|shards:UNAVAILABLE`;\n\nconst queries = [\n  {\n    expr:\n      `count by (__name__) (` +\n      `{service_name=~\"${serviceRegexPromQL}\",__name__=~\"mongodb_.+\"}` +\n      `)`,\n    format: 'time_series',\n    instant: true,\n    range: false,\n    legendFormat: '{{__name__}}',\n    refId: 'MONGO_ALL_METRICS',\n    datasource: {\n      type: 'prometheus',\n      uid: cfg.prometheus_datasource_uid\n    },\n    datasourceId: Number(cfg.prometheus_datasource_id || 1),\n    intervalMs: Number(cfg.sampling_interval_ms || 300000),\n    maxDataPoints: 10000\n  },\n  {\n    expr:\n      `count by (__name__) (` +\n      `{node_name=~\"${nodeRegexPromQL}\",__name__=~\"node_.+\"}` +\n      `)`,\n    format: 'time_series',\n    instant: true,\n    range: false,\n    legendFormat: '{{__name__}}',\n    refId: 'NODE_METRICS',\n    datasource: {\n      type: 'prometheus',\n      uid: cfg.prometheus_datasource_uid\n    },\n    datasourceId: Number(cfg.prometheus_datasource_id || 1),\n    intervalMs: Number(cfg.sampling_interval_ms || 300000),\n    maxDataPoints: 10000\n  }\n];\n\nreturn [{\n  json: {\n    ...cfg,\n\n    selected_cluster_signature: clusterSignature,\n    selected_cluster_name:\n      selectedShards.length\n        ? `sharded cluster via ${cfg.selected_mongos.node_name} — shards ${selectedShards.join(', ')}`\n        : `sharded cluster via ${cfg.selected_mongos.node_name} — shard membership unavailable`,\n\n    selected_shard_names: selectedShards,\n    shard_membership_available: selectedShards.length > 0,\n\n    selected_mongos_service_names:\n      matchingMongosServices.sort(),\n\n    cluster_services: clusterServices,\n    selected_service_names: serviceNames,\n    selected_node_names: nodeNames,\n\n    expected_service_count: clusterServices.length || 1,\n    expected_replica_set_count: replicaSets.length,\n    expected_mongos_count: matchingMongosServices.length,\n\n    service_name_regex: serviceRegex,\n    resolved_node_name_regex: nodeRegex,\n\n    topology_selection_snapshot: {\n      data_shard_replica_sets: replicaSets,\n      selected_mongos_services:\n        matchingMongosServices.sort(),\n\n      explicitly_labeled_config_server_services:\n        configServerCatalogServices.map(s => ({\n          node_name: s.node_name,\n          service_name: s.service_name,\n          replica_set: s.replica_set || null,\n          cl_role: s.cl_role || s.cluster_role || null\n        })),\n\n      assembly_method:\n        selectedShards.length\n          ? 'mongos shard-label signature'\n          : 'mongos only; shards collector unavailable'\n    },\n\n    node_discovery_url:\n      `${String(cfg.pmm_base_url).replace(/\\/$/, '')}` +\n      '/graph/api/ds/query?ds_type=prometheus&requestId=MONGOCLUSTERCOMBINEDINV',\n\n    node_discovery_body: {\n      queries,\n      from: cfg.from_ms,\n      to: cfg.to_ms\n    }\n  }\n}];"
