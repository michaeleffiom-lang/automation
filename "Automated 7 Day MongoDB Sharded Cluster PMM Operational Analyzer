    {
      "parameters": {
        "jsCode": "const analysis = $json;\nconst metrics =\n  (Array.isArray(analysis.metrics) ? analysis.metrics : [])\n    .filter(m => !m.error);\n\nfunction finite(v) {\n  if (v === null || v === undefined) return null;\n  if (typeof v === 'string' && v.trim() === '') return null;\n  const n = Number(v);\n  return Number.isFinite(n) ? n : null;\n}\nfunction fmt(v, digits = 2) {\n  const n = finite(v);\n  return n === null\n    ? 'n/a'\n    : n.toLocaleString('en-US', { maximumFractionDigits: digits });\n}\nfunction pctShare(v, total) {\n  const x = finite(v);\n  const t = finite(total);\n  return x === null || t === null || t <= 0 ? null : 100 * x / t;\n}\nfunction fmtBytes(v) {\n  const n = finite(v);\n  if (n === null) return 'n/a';\n  const abs = Math.abs(n);\n  if (abs >= 1024 ** 4) return `${fmt(n / (1024 ** 4))} TiB`;\n  if (abs >= 1024 ** 3) return `${fmt(n / (1024 ** 3))} GiB`;\n  if (abs >= 1024 ** 2) return `${fmt(n / (1024 ** 2))} MiB`;\n  if (abs >= 1024) return `${fmt(n / 1024)} KiB`;\n  return `${fmt(n)} B`;\n}\nfunction stateName(code) {\n  const map = {\n    0:'STARTUP',1:'PRIMARY',2:'SECONDARY',3:'RECOVERING',\n    5:'STARTUP2',6:'UNKNOWN',7:'ARBITER',8:'DOWN',\n    9:'ROLLBACK',10:'REMOVED'\n  };\n  const n = finite(code);\n  return n === null ? 'UNRESOLVED' : (map[n] || `STATE_${n}`);\n}\nfunction list(key) {\n  return metrics.filter(m => m.metric_key === key);\n}\nfunction label(m, ...names) {\n  for (const name of names) {\n    const v = m?.labels?.[name];\n    if (v !== undefined && v !== null && String(v) !== '') return String(v);\n  }\n  return null;\n}\nfunction memberKey(node, service) {\n  return `${node || ''}|||${service || ''}`;\n}\n\nconst selectedClusterSignature =\n  analysis.target?.selected_cluster_signature || null;\n\nconst selectedCluster =\n  analysis.target?.selected_cluster_name ||\n  'mongos-anchored sharded cluster';\n\nconst selectedMongos =\n  analysis.target?.selected_mongos || null;\n\nconst selectedShardNames =\n  Array.isArray(analysis.target?.selected_shard_names)\n    ? analysis.target.selected_shard_names\n    : [];\n\nconst shardMembershipAvailable =\n  Boolean(analysis.target?.shard_membership_available);\n\nconst catalogServices =\n  Array.isArray(analysis.target?.cluster_services)\n    ? analysis.target.cluster_services\n    : [];\n\nconst services = new Map();\n\nfor (const svc of catalogServices) {\n  services.set(memberKey(svc.node_name, svc.service_name), {\n    node_name: svc.node_name,\n    service_name: svc.service_name,\n    cl_role: svc.cl_role || null,\n    cluster_role: svc.cluster_role || null,\n    replica_set: svc.replica_set || null,\n    current_state_code: finite(svc.state_code),\n    current_state: stateName(svc.state_code),\n    environment: svc.environment || null\n  });\n}\n\n// Merge latest state from the time-series.\nfor (const m of list('replica_state_code')) {\n  const node = label(m,'node_name');\n  const service = label(m,'service_name');\n  const key = memberKey(node, service);\n  const current = services.get(key);\n  if (!current) continue;\n\n  const last = finite(m.summary?.last);\n  if (last !== null) {\n    current.current_state_code = last;\n    current.current_state = stateName(last);\n  }\n\n  current.observed_states =\n    Array.isArray(m.summary?.distinct_values)\n      ? m.summary.distinct_values\n          .map(finite)\n          .filter(x => x !== null)\n          .map(stateName)\n      : [current.current_state];\n}\n\nfunction metricForService(key, svc) {\n  return list(key).find(m =>\n    (!label(m,'node_name') || label(m,'node_name') === svc.node_name) &&\n    (!label(m,'service_name') || label(m,'service_name') === svc.service_name)\n  ) || null;\n}\nfunction stat(key, svc, which='avg') {\n  return finite(metricForService(key, svc)?.summary?.[which]);\n}\nfunction hostStat(key, svc, which='avg') {\n  return finite(\n    list(key).find(m => label(m,'node_name') === svc.node_name)\n      ?.summary?.[which]\n  );\n}\n\nconst serviceRows = [...services.values()].map(svc => ({\n  ...svc,\n  is_mongos:\n    String(svc.cl_role || '').toLowerCase() === 'mongos' ||\n    String(svc.cluster_role || '').toLowerCase() === 'mongos',\n\n  workload: {\n    read_avg: stat('read_ops_per_second', svc),\n    write_avg: stat('write_ops_per_second', svc),\n    command_avg: stat('command_ops_per_second', svc)\n  },\n\n  latency: {\n    read_avg: stat('read_avg_latency_ms', svc),\n    write_avg: stat('write_avg_latency_ms', svc),\n    command_avg: stat('command_avg_latency_ms', svc)\n  },\n\n  connections: {\n    current_avg: stat('connections_current', svc),\n    utilization_avg: stat('connections_utilization_pct', svc)\n  },\n\n  network: {\n    bytes_in_avg: stat('mongodb_network_bytes_in_per_second', svc),\n    bytes_out_avg: stat('mongodb_network_bytes_out_per_second', svc),\n    requests_avg: stat('mongodb_network_requests_per_second', svc)\n  },\n\n  wiredtiger: {\n    cache_utilization_avg: stat('wt_cache_utilization_pct', svc),\n    dirty_pct_avg: stat('wt_cache_dirty_pct_of_max', svc)\n  },\n\n  replication: {\n    oplog_window_min_hours: stat('oplog_window_hours', svc, 'min')\n  },\n\n  host: {\n    cpu_avg: hostStat('host_cpu_utilization_pct', svc),\n    memory_avg: hostStat('host_memory_utilization_pct', svc),\n    disk_busy_avg: hostStat('disk_busy_pct_max_device', svc),\n    filesystem_used_max: hostStat('filesystem_used_pct_max', svc, 'max')\n  }\n}));\n\nconst mongos = serviceRows.filter(x => x.is_mongos);\n\nconst configServerServices = serviceRows.filter(x => {\n  const role =\n    String(x.cl_role || x.cluster_role || '')\n      .toLowerCase()\n      .replace(/[ _-]/g, '');\n\n  return role === 'configsvr' || role === 'configserver';\n});\n\nconst configServerCoverageAvailable =\n  configServerServices.length > 0;\n\nconst batchArchitecture =\n  analysis.batch_architecture || {};\n\nconst completedBatchCount =\n  Number(batchArchitecture.batch_count || 0);\n\nconst completedShardBatchCount =\n  Number(batchArchitecture.replica_set_batch_count || 0);\n\nconst completedMongosBatchCount =\n  Number(batchArchitecture.mongos_batch_count || 0);\n\nconst completedClusterMetadataBatchCount =\n  Number(batchArchitecture.cluster_metadata_batch_count || 0);\n\nconst completedConfigBatchCount =\n  Number(batchArchitecture.config_server_batch_count || 0);\n\nconst replicaSetsMap = new Map();\nfor (const svc of serviceRows) {\n  if (!svc.replica_set) continue;\n  if (!replicaSetsMap.has(svc.replica_set)) {\n    replicaSetsMap.set(svc.replica_set, {\n      replica_set: svc.replica_set,\n      members: []\n    });\n  }\n  replicaSetsMap.get(svc.replica_set).members.push(svc);\n}\n\nconst replicaSets = [...replicaSetsMap.values()]\n  .map(rs => {\n    const primaries = rs.members.filter(x => x.current_state === 'PRIMARY');\n    const secondaries = rs.members.filter(x => x.current_state === 'SECONDARY');\n    const arbiters = rs.members.filter(x => x.current_state === 'ARBITER');\n\n    return {\n      ...rs,\n      primary_count: primaries.length,\n      secondary_count: secondaries.length,\n      arbiter_count: arbiters.length,\n      primary: primaries[0] || null,\n      current_states:\n        Object.fromEntries(\n          [...new Set(rs.members.map(x => x.current_state))]\n            .map(state => [\n              state,\n              rs.members.filter(x => x.current_state === state).length\n            ])\n        )\n    };\n  })\n  .sort((a,b) => a.replica_set.localeCompare(b.replica_set));\n\n// ------------------------------------------------------------------\n// Shard/chunk metadata.\n// ------------------------------------------------------------------\nconst chunkSeries = list('shard_chunks_count');\nconst shardNames =\n  [...new Set(\n    chunkSeries\n      .map(m => label(m,'shard'))\n      .filter(Boolean)\n  )];\n\nconst shardChunkRows = chunkSeries\n  .map(m => ({\n    shard: label(m,'shard'),\n    chunks_avg: finite(m.summary?.avg),\n    chunks_last: finite(m.summary?.last),\n    chunks_max: finite(m.summary?.max)\n  }))\n  .filter(x => x.shard)\n  .sort((a,b) => (b.chunks_last ?? b.chunks_avg ?? 0) -\n                 (a.chunks_last ?? a.chunks_avg ?? 0));\n\nconst totalChunks =\n  shardChunkRows.reduce(\n    (sum, x) => sum + (finite(x.chunks_last) ?? finite(x.chunks_avg) ?? 0),\n    0\n  );\n\nfor (const row of shardChunkRows) {\n  row.chunk_share_pct =\n    pctShare(row.chunks_last ?? row.chunks_avg, totalChunks);\n}\n\nconst namespaceCountMetric =\n  list('sharded_namespace_count')[0] || null;\n\nconst namespaceCount =\n  finite(\n    namespaceCountMetric?.summary?.last ??\n    namespaceCountMetric?.summary?.max ??\n    namespaceCountMetric?.summary?.avg\n  );\n\n// Data-shard mapping is evidence-based only: rs name must appear as shard label.\nconst dataShardReplicaSets =\n  replicaSets.filter(rs => shardNames.includes(rs.replica_set));\n\nconst unclassifiedReplicaSets =\n  replicaSets.filter(rs => !shardNames.includes(rs.replica_set));\n\n// If chunks collector is absent, do not guess which RS is shard vs config server.\nconst shardClassificationAvailable =\n  shardNames.length > 0;\n\n// ------------------------------------------------------------------\n// Per-shard PRIMARY workload distribution.\n// ------------------------------------------------------------------\nconst shardPrimaryRows =\n  dataShardReplicaSets\n    .filter(rs => rs.primary)\n    .map(rs => ({\n      shard: rs.replica_set,\n      primary_node: rs.primary.node_name,\n      primary_service: rs.primary.service_name,\n      read_avg: rs.primary.workload.read_avg,\n      write_avg: rs.primary.workload.write_avg,\n      command_avg: rs.primary.workload.command_avg,\n      cpu_avg: rs.primary.host.cpu_avg,\n      disk_busy_avg: rs.primary.host.disk_busy_avg,\n      filesystem_used_max: rs.primary.host.filesystem_used_max\n    }));\n\nconst shardPrimaryWriteObservedTotal =\n  shardPrimaryRows.reduce(\n    (sum,x) => sum + (finite(x.write_avg) || 0),\n    0\n  );\nconst shardPrimaryReadObservedTotal =\n  shardPrimaryRows.reduce(\n    (sum,x) => sum + (finite(x.read_avg) || 0),\n    0\n  );\n\nfor (const row of shardPrimaryRows) {\n  row.write_share_of_observed_shard_primary_rate_pct =\n    pctShare(row.write_avg, shardPrimaryWriteObservedTotal);\n  row.read_share_of_observed_shard_primary_rate_pct =\n    pctShare(row.read_avg, shardPrimaryReadObservedTotal);\n}\n\n// ------------------------------------------------------------------\n// Replication lag across all replica sets.\n// ------------------------------------------------------------------\nconst serviceByNode =\n  new Map(serviceRows.map(s => [s.node_name, s]));\n\nfunction memberHost(value) {\n  if (!value) return null;\n  return String(value).replace(/:\\d+$/, '');\n}\n\nconst rawLagRows = list('replication_lag_seconds').map(m => {\n  const observedMember =\n    label(m,'member','member_name','name','node_name','service_name');\n\n  const targetHost = memberHost(observedMember);\n  const mappedService =\n    targetHost ? serviceByNode.get(targetHost) : null;\n\n  return {\n    replica_set:\n      label(m,'rs_nm','replication_set','set') ||\n      mappedService?.replica_set ||\n      null,\n\n    observed_member: observedMember,\n    target_host: targetHost,\n    exporter_perspective_node: label(m,'node_name'),\n    avg: finite(m.summary?.avg),\n    p99: finite(m.summary?.p99),\n    max: finite(m.summary?.max)\n  };\n});\n\nconst lagByTarget = new Map();\n\nfor (const row of rawLagRows) {\n  const key =\n    `${row.replica_set || ''}|||${row.target_host || row.observed_member || ''}`;\n\n  const current = lagByTarget.get(key);\n\n  if (!current) {\n    lagByTarget.set(key, {\n      ...row,\n      perspective_count: 1,\n      perspective_nodes:\n        row.exporter_perspective_node\n          ? [row.exporter_perspective_node]\n          : []\n    });\n    continue;\n  }\n\n  current.perspective_count++;\n\n  if (\n    row.exporter_perspective_node &&\n    !current.perspective_nodes.includes(row.exporter_perspective_node)\n  ) {\n    current.perspective_nodes.push(row.exporter_perspective_node);\n  }\n\n  if (\n    finite(row.max) !== null &&\n    (\n      finite(current.max) === null ||\n      row.max > current.max\n    )\n  ) {\n    current.avg = row.avg;\n    current.p99 = row.p99;\n    current.max = row.max;\n    current.exporter_perspective_node = row.exporter_perspective_node;\n  }\n}\n\nconst lagRows =\n  [...lagByTarget.values()]\n    .sort((a,b) => (b.max ?? -1) - (a.max ?? -1));\n\nconst worstLagMax =\n  lagRows.length ? finite(lagRows[0].max) : null;\n\nconst worstLagRows =\n  worstLagMax === null\n    ? []\n    : lagRows.filter(x => finite(x.max) === worstLagMax);\n\nconst worstLag =\n  worstLagRows[0] || null;\n\n// ------------------------------------------------------------------\n// Balancer and dynamic capabilities.\n// ------------------------------------------------------------------\nconst balancerSeries = list('balancer_enabled');\nconst balancerValues =\n  balancerSeries\n    .map(m => ({\n      service: label(m,'service_name'),\n      node: label(m,'node_name'),\n      last: finite(m.summary?.last),\n      min: finite(m.summary?.min),\n      max: finite(m.summary?.max)\n    }));\n\nfunction totalSummary(key, which='last') {\n  const rows = list(key)\n    .map(m => finite(m.summary?.[which]))\n    .filter(v => v !== null);\n\n  if (!rows.length) return null;\n  return rows.reduce((a,b) => a + b, 0);\n}\n\nfunction maxSummary(key, which='last') {\n  const rows = list(key)\n    .map(m => finite(m.summary?.[which]))\n    .filter(v => v !== null);\n\n  return rows.length ? Math.max(...rows) : null;\n}\n\nconst balancerRunningValues =\n  list('balancer_running').map(m => ({\n    service: label(m,'service_name'),\n    node: label(m,'node_name'),\n    last: finite(m.summary?.last)\n  }));\n\nconst shardingActivity = {\n  move_chunk_started_counter_increase_7d:\n    totalSummary('move_chunk_started_increase_7d'),\n\n  move_chunk_committed_counter_increase_7d:\n    totalSummary('move_chunk_committed_increase_7d'),\n\n  move_chunk_aborted_counter_increase_7d:\n    totalSummary('move_chunk_aborted_increase_7d'),\n\n  range_deleter_tasks_current_sum:\n    totalSummary('range_deleter_tasks_current'),\n\n  range_deleter_tasks_current_max:\n    maxSummary('range_deleter_tasks_current'),\n\n  range_deleter_docs_counter_increase_7d:\n    totalSummary('range_deleter_docs_increase_7d'),\n\n  range_deleter_bytes_counter_increase_7d:\n    totalSummary('range_deleter_bytes_increase_7d'),\n\n  unfinished_migration_from_previous_primary_max:\n    maxSummary('unfinished_migration_from_previous_primary'),\n\n  mongos_shards_total:\n    maxSummary('mongos_shards_total'),\n\n  mongos_shards_draining_total:\n    maxSummary('mongos_shards_draining_total')\n};\n\nfunction shardMetricValue(key, shard) {\n  const m = list(key).find(x => label(x,'shard') === shard);\n  return finite(\n    m?.summary?.last ??\n    m?.summary?.max ??\n    m?.summary?.avg\n  );\n}\n\nconst shardDataRows =\n  selectedShardNames.map(shard => ({\n    shard,\n    data_size_bytes:\n      shardMetricValue('shard_dbstats_data_size_bytes', shard),\n    storage_size_bytes:\n      shardMetricValue('shard_dbstats_storage_size_bytes', shard),\n    index_size_bytes:\n      shardMetricValue('shard_dbstats_index_size_bytes', shard),\n    objects:\n      shardMetricValue('shard_dbstats_objects', shard)\n  }));\n\nconst totalShardDataSize =\n  shardDataRows.reduce(\n    (sum,x) => sum + (finite(x.data_size_bytes) || 0),\n    0\n  );\n\nconst totalShardStorageSize =\n  shardDataRows.reduce(\n    (sum,x) => sum + (finite(x.storage_size_bytes) || 0),\n    0\n  );\n\nfor (const row of shardDataRows) {\n  row.data_size_share_pct =\n    pctShare(row.data_size_bytes, totalShardDataSize);\n\n  row.storage_size_share_pct =\n    pctShare(row.storage_size_bytes, totalShardStorageSize);\n}\n\nconst inventory = analysis.metric_inventory || {};\n\nconst capabilities = {\n  mongos_anchored_membership:\n    Boolean(shardMembershipAvailable),\n\n  mongos_services_detected:\n    mongos.length > 0,\n\n  config_server_topology_detected:\n    configServerCoverageAvailable,\n\n  replica_sets_detected:\n    replicaSets.length > 0,\n\n  shards_collector_chunk_metric:\n    Boolean(inventory.has_shards_collector_metric),\n\n  shard_classification_from_chunk_labels:\n    shardClassificationAvailable,\n\n  balancer_enabled_metric:\n    Boolean(inventory.has_balancer_metric),\n\n  balancer_running_metric:\n    Boolean(inventory.has_balancer_running_metric),\n\n  raw_shard_dbstats_data_size:\n    Boolean(inventory.has_raw_shard_dbstats_data_size),\n\n  dbstats_metrics_detected:\n    Boolean(inventory.has_dbstats_metrics),\n\n  collstats_metrics_detected:\n    Boolean(inventory.has_collstats_metrics),\n\n  indexstats_metrics_detected:\n    Boolean(inventory.has_indexstats_metrics),\n\n  move_chunk_activity_metrics:\n    Boolean(inventory.has_move_chunk_activity_metrics),\n\n  range_deleter_activity_metrics:\n    Boolean(inventory.has_range_deleter_activity_metrics),\n\n  unfinished_migration_metric:\n    Boolean(inventory.has_unfinished_migration_metric),\n\n  jumbo_chunk_state_metric:\n    Boolean(inventory.has_jumbo_chunk_state_metric),\n\n  discovered_sharding_metric_count:\n    Array.isArray(inventory.sharding_capability_metric_names)\n      ? inventory.sharding_capability_metric_names.length\n      : 0,\n\n  dynamic_unmodeled_sharding_metric_count:\n    Array.isArray(inventory.dynamic_sharding_metric_names)\n      ? inventory.dynamic_sharding_metric_names.length\n      : 0\n};\n\n// ------------------------------------------------------------------\n// Host asymmetry.\n// ------------------------------------------------------------------\nfunction highestService(path) {\n  const p = path.split('.');\n  const rows = serviceRows\n    .map(svc => {\n      let v = svc;\n      for (const part of p) v = v?.[part];\n      return {\n        node: svc.node_name,\n        service: svc.service_name,\n        replica_set: svc.replica_set,\n        role: svc.current_state,\n        value: finite(v)\n      };\n    })\n    .filter(x => x.value !== null)\n    .sort((a,b) => b.value - a.value);\n\n  return rows[0] || null;\n}\n\nconst resourceComparison = {\n  highest_cpu_avg: highestService('host.cpu_avg'),\n  highest_disk_busy_avg: highestService('host.disk_busy_avg'),\n  highest_filesystem_used_max: highestService('host.filesystem_used_max'),\n  highest_connection_utilization_avg:\n    highestService('connections.utilization_avg')\n};\n\n// ------------------------------------------------------------------\n// Dynamic raw metric summary.\n// ------------------------------------------------------------------\nconst rawShardingMetrics = metrics\n  .filter(m => m.category === 'PMM Sharding Capability')\n  .map(m => ({\n    metric_key: m.metric_key,\n    source_metric_names: m.source_metric_names,\n    labels: m.labels,\n    summary: m.summary,\n    semantics: m.semantics\n  }));\n\nconst clusterProfile = {\n  cluster_signature: selectedClusterSignature,\n\n  execution_architecture:\n    analysis.batch_architecture || null,\n  display_name: selectedCluster,\n  selected_mongos: selectedMongos,\n  selected_shard_names: selectedShardNames,\n  shard_membership_available: shardMembershipAvailable,\n\n  environments:\n    [...new Set(serviceRows.map(x => x.environment).filter(Boolean))],\n\n  monitored_service_count: serviceRows.length,\n  monitored_node_count:\n    new Set(serviceRows.map(x => x.node_name)).size,\n\n  mongos_count: mongos.length,\n  mongos,\n\n  explicitly_labeled_config_server_count:\n    configServerServices.length,\n  explicitly_labeled_config_server_services:\n    configServerServices,\n\n  replica_set_count: replicaSets.length,\n  replica_sets: replicaSets,\n\n  shard_classification_available: shardClassificationAvailable,\n  data_shard_replica_sets:\n    dataShardReplicaSets.map(x => x.replica_set),\n  unclassified_replica_sets:\n    unclassifiedReplicaSets.map(x => x.replica_set),\n\n  chunk_distribution: {\n    available: shardChunkRows.length > 0,\n    total_observed_chunks: totalChunks || null,\n    sharded_namespace_count: namespaceCount || null,\n    per_shard: shardChunkRows\n  },\n\n  shard_primary_workload_distribution: shardPrimaryRows,\n\n  replication: {\n    lag_available: lagRows.length > 0,\n    worst_lag: worstLag,\n    lag_rows: lagRows\n  },\n\n  balancer: {\n    enabled_metric_available: balancerValues.length > 0,\n    enabled_routers: balancerValues,\n    running_metric_available: balancerRunningValues.length > 0,\n    running_routers: balancerRunningValues\n  },\n\n  sharding_activity: shardingActivity,\n\n  shard_data_snapshot: {\n    available:\n      shardDataRows.some(x =>\n        finite(x.data_size_bytes) !== null ||\n        finite(x.storage_size_bytes) !== null\n      ),\n    per_shard: shardDataRows\n  },\n\n  resource_comparison: resourceComparison,\n  capabilities\n};\n\n// ------------------------------------------------------------------\n// Deterministic fallback.\n// ------------------------------------------------------------------\nfunction topologyRows() {\n  if (!serviceRows.length) return '| n/a | n/a | n/a | n/a | n/a |';\n\n  return serviceRows.map(s =>\n    `| ${s.node_name} | ${s.service_name} | ${s.cl_role || s.cluster_role || 'unresolved'} | ${s.replica_set || 'N/A'} | ${s.is_mongos ? 'N/A' : s.current_state} |`\n  ).join('\\n');\n}\n\nfunction replicaSetRows() {\n  if (!replicaSets.length) return '- No replica sets were resolved.';\n  return replicaSets.map(rs =>\n    `- **${rs.replica_set}** — members ${rs.members.length}; PRIMARY ${rs.primary_count}; SECONDARY ${rs.secondary_count}; ARBITER ${rs.arbiter_count}.`\n  ).join('\\n');\n}\n\nfunction chunkRows() {\n  if (!shardChunkRows.length) {\n    return '- Chunk distribution metric is not available. Shard/chunk distribution cannot be assessed from PMM in this execution.';\n  }\n\n  return shardChunkRows.map(x =>\n    `- **${x.shard}** — observed chunks ${fmt(x.chunks_last ?? x.chunks_avg)}; share of observed chunk count ${fmt(x.chunk_share_pct)}%.`\n  ).join('\\n');\n}\n\nfunction shardWorkloadRows() {\n  if (!shardPrimaryRows.length) {\n    return '- Data-shard PRIMARY workload distribution could not be constructed because shard classification from PMM chunk labels was unavailable.';\n  }\n\n  return shardPrimaryRows.map(x =>\n    `- **${x.shard}** PRIMARY ${x.primary_node} — reads ${fmt(x.read_avg)}/sec; writes ${fmt(x.write_avg)}/sec; commands ${fmt(x.command_avg)}/sec; observed read-rate share ${fmt(x.read_share_of_observed_shard_primary_rate_pct)}%; observed write-rate share ${fmt(x.write_share_of_observed_shard_primary_rate_pct)}%.`\n  ).join('\\n');\n}\n\nfunction mongosRows() {\n  if (!mongos.length) return '- No mongos service was resolved from PMM topology labels.';\n  return mongos.map(m =>\n    `- **${m.node_name}** — service ${m.service_name}; reads ${fmt(m.workload.read_avg)}/sec; writes ${fmt(m.workload.write_avg)}/sec; commands ${fmt(m.workload.command_avg)}/sec; requests ${fmt(m.network.requests_avg)}/sec; connection utilization ${fmt(m.connections.utilization_avg)}%.`\n  ).join('\\n');\n}\n\nfunction capabilityRows() {\n  const rows = [\n    ['mongos-anchored shard membership',\n      capabilities.mongos_anchored_membership ? 'Available' : 'Not available'],\n\n    ['mongos topology',\n      capabilities.mongos_services_detected ? 'Available' : 'Not detected'],\n\n    ['Config-server topology',\n      capabilities.config_server_topology_detected ? 'Available' : 'Not detected / not analyzed'],\n\n    ['Replica-set topology',\n      capabilities.replica_sets_detected ? 'Available' : 'Not detected'],\n\n    ['Shard/chunk distribution',\n      capabilities.shards_collector_chunk_metric ? 'Available' : 'Not detected'],\n\n    ['Shard classification from chunk labels',\n      capabilities.shard_classification_from_chunk_labels ? 'Available' : 'Not available'],\n\n    ['Balancer enabled state',\n      capabilities.balancer_enabled_metric ? 'Available' : 'Not detected'],\n\n    ['Balancer running state',\n      capabilities.balancer_running_metric ? 'Available' : 'Not detected'],\n\n    ['Per-shard dbStats size snapshot',\n      capabilities.raw_shard_dbstats_data_size ? 'Available' : 'Not detected'],\n\n    ['Move-chunk activity counters',\n      capabilities.move_chunk_activity_metrics ? 'Available' : 'Not detected'],\n\n    ['Range-deleter activity',\n      capabilities.range_deleter_activity_metrics ? 'Available' : 'Not detected'],\n\n    ['Unfinished-migration state',\n      capabilities.unfinished_migration_metric ? 'Available' : 'Not detected'],\n\n    ['Jumbo-chunk current state/count',\n      capabilities.jumbo_chunk_state_metric ? 'Available' : 'Not detected'],\n\n    ['collStats metrics',\n      capabilities.collstats_metrics_detected ? 'Detected in inventory; not analyzed in current workflow' : 'Not detected'],\n\n    ['indexStats metrics',\n      capabilities.indexstats_metrics_detected ? 'Detected in inventory; not analyzed in current workflow' : 'Not detected']\n  ];\n\n  return rows.map(([name, status]) =>\n    `| ${name} | ${status} |`\n  ).join('\\n');\n}\n\nfunction replLagRows() {\n  if (!lagRows.length) {\n    return '- Replication-lag metrics were not available.';\n  }\n\n  return lagRows\n    .map(x =>\n      `- ${x.replica_set || 'unresolved RS'} / ${x.observed_member || 'unresolved member'} — avg ${fmt(x.avg)} sec; p99 ${fmt(x.p99)} sec; max ${fmt(x.max)} sec; exporter perspectives deduplicated ${x.perspective_count || 1}.`\n    ).join('\\n');\n}\n\nconst assessment = [];\n\nassessment.push(\n  `**Topology:** ${serviceRows.length} MongoDB service(s) across ${replicaSets.length} resolved replica set(s) and ${mongos.length} mongos router(s).`\n);\n\nif (!configServerCoverageAvailable) {\n  assessment.push