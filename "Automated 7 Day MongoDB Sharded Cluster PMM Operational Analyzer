      "parameters": {
        "jsCode": "const combinedInventoryResponse = $json;\nconst mongoInventoryResponse = combinedInventoryResponse;\nconst nodeInventoryResponse = combinedInventoryResponse;\nconst cfg = $('Build Cluster Node Metric Discovery').first().json;\n\nfunction esc(v) {\n  return String(v ?? '')\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\n/g, '');\n}\n\nfunction extractMetricNames(resp, refId, prefix) {\n  const names = new Set();\n  const frames = resp?.results?.[refId]?.frames || [];\n\n  for (const frame of frames) {\n    const fields = frame?.schema?.fields || [];\n\n    for (const field of fields) {\n      const labels =\n        field?.labels ||\n        field?.config?.labels ||\n        frame?.schema?.meta?.custom?.labels ||\n        {};\n\n      if (labels?.__name__) names.add(String(labels.__name__));\n\n      const display =\n        field?.config?.displayNameFromDS ||\n        field?.config?.displayName ||\n        field?.name ||\n        frame?.schema?.name ||\n        '';\n\n      const s = String(display);\n      const byLabel = s.match(/__name__=\"?([^\",}]+)\"?/);\n      if (byLabel?.[1]) names.add(byLabel[1]);\n\n      if (\n        prefix &&\n        s.startsWith(prefix) &&\n        /^[A-Za-z_:][A-Za-z0-9_:]*$/.test(s)\n      ) {\n        names.add(s);\n      }\n    }\n  }\n\n  return [...names]\n    .filter(x => !prefix || x.startsWith(prefix))\n    .sort();\n}\n\nconst mongoNames =\n  extractMetricNames(mongoInventoryResponse, 'MONGO_ALL_METRICS', 'mongodb_');\nconst nodeNames =\n  extractMetricNames(nodeInventoryResponse, 'NODE_METRICS', 'node_');\n\nconst mongoSet = new Set(mongoNames);\nconst nodeSet = new Set(nodeNames);\n\nfunction pick(set, candidates) {\n  return candidates.find(x => set.has(x)) || null;\n}\nfunction hasNode(...names) {\n  return names.every(x => nodeSet.has(x));\n}\n\nconst clusterName = esc(cfg.selected_cluster_name);\nconst serviceRegex = esc(cfg.service_name_regex);\nconst nodeRegex = esc(cfg.resolved_node_name_regex);\n\nif (!serviceRegex) {\n  throw new Error('service_name_regex is required for cluster metric queries.');\n}\n\nconst clusterScope = `service_name=~\"${serviceRegex}\"`;\nconst nodeScope = `node_name=~\"${nodeRegex}\"`;\n\nfunction regexEscapeLiteral(value) {\n  return String(value ?? '').replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nconst selectedMongosNames =\n  Array.isArray(cfg.selected_mongos_service_names)\n    ? cfg.selected_mongos_service_names.filter(Boolean)\n    : [];\n\nconst mongosRegexRaw =\n  selectedMongosNames.length\n    ? `^(?:${selectedMongosNames.map(regexEscapeLiteral).join('|')})$`\n    : cfg.all_mongos_service_regex || cfg.service_name_regex;\n\nconst mongosRegex = esc(mongosRegexRaw);\nconst mongosScope = `service_name=~\"${mongosRegex}\"`;\n\nconst descriptors = [];\nconst queries = [];\nlet refSeq = 0;\n\nfunction nextRef() {\n  refSeq++;\n  return `C${String(refSeq).padStart(3, '0')}`;\n}\n\nfunction pushQuery({\n  key,\n  legend,\n  expr,\n  category,\n  source = 'mongodb',\n  unit,\n  semantics,\n  metricNames = [],\n  rateWindow = null,\n  queryKind = 'derived',\n  variability = true,\n  instant = false,\n  range = true,\n  staticLabels = {}\n}) {\n  const refId = nextRef();\n\n  descriptors.push({\n    refId,\n    metric_key: key,\n    legend,\n    category,\n    source,\n    unit,\n    semantics,\n    metric_names: metricNames,\n    rate_window: rateWindow,\n    query_kind: queryKind,\n    classify_variability: variability,\n    static_labels: staticLabels\n  });\n\n  queries.push({\n    expr,\n    format: 'time_series',\n    interval: cfg.sampling_interval || '5m',\n    intervalFactor: 1,\n    instant,\n    range,\n    legendFormat: legend,\n    refId,\n    datasource: {\n      type: 'prometheus',\n      uid: cfg.prometheus_datasource_uid\n    },\n    exemplar: false,\n    requestId: `MONGOCLUSTER-${refId}`,\n    utcOffsetSec: 0,\n    scopes: [],\n    adhocFilters: [],\n    datasourceId: Number(cfg.prometheus_datasource_id || 1),\n    intervalMs: Number(cfg.sampling_interval_ms || 300000),\n    maxDataPoints: Number(cfg.max_data_points || 3000)\n  });\n}\n\n// ------------------------------------------------------------------\n// Topology / state.\n// ------------------------------------------------------------------\nconst up = pick(mongoSet, ['mongodb_up']);\nif (up) {\n  pushQuery({\n    key: 'cluster_topology_identity',\n    legend: 'MongoDB cluster topology identity',\n    expr:\n      `max by (` +\n      `cluster,node_name,service_name,cl_role,cluster_role,` +\n      `rs_nm,replication_set,set,rs_state,state,environment,cl_id` +\n      `) (${up}{${clusterScope}})`,\n    category: 'Topology',\n    unit: 'boolean',\n    semantics:\n      'PMM/exporter topology labels for all MongoDB services in the selected cluster.',\n    metricNames: [up],\n    queryKind: 'identity',\n    variability: false,\n    instant: true,\n    range: false\n  });\n\n  pushQuery({\n    key: 'cluster_service_reachability',\n    legend: 'MongoDB service reachability',\n    expr:\n      `min by (cluster,node_name,service_name,cl_role,rs_nm) (` +\n      `${up}{${clusterScope}})`,\n    category: 'Topology',\n    unit: 'boolean',\n    semantics:\n      'Per-service MongoDB exporter/database reachability.',\n    metricNames: [up],\n    queryKind: 'gauge',\n    variability: false\n  });\n}\n\nconst myState = pick(mongoSet, ['mongodb_mongod_replset_my_state']);\nif (myState) {\n  pushQuery({\n    key: 'replica_state_code',\n    legend: 'Replica-set member state code',\n    expr:\n      `max by (` +\n      `cluster,node_name,service_name,cl_role,rs_nm,replication_set,set,environment` +\n      `) (${myState}{${clusterScope}})`,\n    category: 'Topology',\n    unit: 'state_code',\n    semantics:\n      'MongoDB replSetGetStatus.myState code per monitored replica-set service.',\n    metricNames: [myState],\n    queryKind: 'state',\n    variability: false\n  });\n}\n\n// ------------------------------------------------------------------\n// Workload / latency per service.\n// ------------------------------------------------------------------\nconst opOps =\n  pick(mongoSet, [\n    'mongodb_ss_opLatencies_ops',\n    'mongodb_mongod_op_latencies_ops_total'\n  ]);\n\nconst opLat =\n  pick(mongoSet, [\n    'mongodb_ss_opLatencies_latency',\n    'mongodb_mongod_op_latencies_latency_total'\n  ]);\n\nfunction opLabel(metric, pluralType) {\n  if (metric === 'mongodb_ss_opLatencies_ops' ||\n      metric === 'mongodb_ss_opLatencies_latency') {\n    return `op_type=\"${pluralType}\"`;\n  }\n  return `type=\"${pluralType.slice(0,-1)}\"`;\n}\n\nif (opOps) {\n  for (const [type, key, label] of [\n    ['reads', 'read_ops_per_second', 'Read operations/sec'],\n    ['writes', 'write_ops_per_second', 'Write operations/sec'],\n    ['commands', 'command_ops_per_second', 'Command operations/sec']\n  ]) {\n    pushQuery({\n      key,\n      legend: label,\n      expr:\n        `sum by (` +\n        `cluster,node_name,service_name,cl_role,rs_nm,rs_state` +\n        `) (rate(${opOps}{${clusterScope},${opLabel(opOps,type)}}[5m]))`,\n      category: 'Workload',\n      unit: 'operations_per_second',\n      semantics:\n        `Per-service MongoDB opLatencies ${type} rate. Cluster totals are not assumed to equal application operation counts.`,\n      metricNames: [opOps],\n      rateWindow: '5m',\n      queryKind: 'rate'\n    });\n  }\n}\n\nif (opOps && opLat) {\n  for (const [type, key, label] of [\n    ['reads', 'read_avg_latency_ms', 'Average read operation latency'],\n    ['writes', 'write_avg_latency_ms', 'Average write operation latency'],\n    ['commands', 'command_avg_latency_ms', 'Average command operation latency']\n  ]) {\n    const selector = opLabel(opOps, type);\n    const latSelector = opLabel(opLat, type);\n    const convert =\n      opLat === 'mongodb_ss_opLatencies_latency' ? ' / 1000' : '';\n\n    pushQuery({\n      key,\n      legend: label,\n      expr:\n        `sum by (cluster,node_name,service_name,cl_role,rs_nm,rs_state) (` +\n        `rate(${opLat}{${clusterScope},${latSelector}}[5m]))` +\n        ` / clamp_min(` +\n        `sum by (cluster,node_name,service_name,cl_role,rs_nm,rs_state) (` +\n        `rate(${opOps}{${clusterScope},${selector}}[5m])),0.000001)` +\n        convert,\n      category: 'Latency',\n      unit:\n        opLat === 'mongodb_ss_opLatencies_latency'\n          ? 'milliseconds_per_operation'\n          : 'exporter_latency_unit_per_operation',\n      semantics:\n        `Average ${type} operation latency per service. No SLA threshold is assumed.`,\n      metricNames: [opLat, opOps],\n      rateWindow: '5m',\n      queryKind: 'derived'\n    });\n  }\n}\n\n// ------------------------------------------------------------------\n// Connections / network.\n// ------------------------------------------------------------------\nconst conn = pick(mongoSet, ['mongodb_ss_connections']);\nif (conn) {\n  pushQuery({\n    key: 'connections_current',\n    legend: 'Current MongoDB connections',\n    expr:\n      `sum by (cluster,node_name,service_name,cl_role,rs_nm) (` +\n      `${conn}{${clusterScope},conn_type=\"current\"})`,\n    category: 'Connections',\n    unit: 'connections',\n    semantics: 'Current MongoDB connections per service.',\n    metricNames: [conn],\n    queryKind: 'gauge'\n  });\n\n  pushQuery({\n    key: 'connections_utilization_pct',\n    legend: 'MongoDB connection utilization',\n    expr:\n      `100 * ` +\n      `sum by (cluster,node_name,service_name,cl_role,rs_nm) (` +\n      `${conn}{${clusterScope},conn_type=\"current\"})` +\n      ` / clamp_min(` +\n      `sum by (cluster,node_name,service_name,cl_role,rs_nm) (` +\n      `${conn}{${clusterScope},conn_type=\"current\"}) + ` +\n      `sum by (cluster,node_name,service_name,cl_role,rs_nm) (` +\n      `${conn}{${clusterScope},conn_type=\"available\"}),1)`,\n    category: 'Connections',\n    unit: 'percent',\n    semantics:\n      'Current divided by current+available connection capacity per service; already on a 0-100 scale.',\n    metricNames: [conn],\n    queryKind: 'derived'\n  });\n}\n\nfor (const [metric, key, legend] of [\n  [pick(mongoSet,['mongodb_ss_network_bytesIn']),\n   'mongodb_network_bytes_in_per_second',\n   'MongoDB network bytes in/sec'],\n  [pick(mongoSet,['mongodb_ss_network_bytesOut']),\n   'mongodb_network_bytes_out_per_second',\n   'MongoDB network bytes out/sec'],\n  [pick(mongoSet,['mongodb_ss_network_numRequests']),\n   'mongodb_network_requests_per_second',\n   'MongoDB network requests/sec']\n]) {\n  if (!metric) continue;\n  pushQuery({\n    key,\n    legend,\n    expr:\n      `sum by (cluster,node_name,service_name,cl_role,rs_nm) (` +\n      `rate(${metric}{${clusterScope}}[5m]))`,\n    category: 'Network',\n    unit:\n      key.includes('bytes_') ? 'bytes_per_second' : 'requests_per_second',\n    semantics:\n      'Per-service MongoDB serverStatus network activity.',\n    metricNames: [metric],\n    rateWindow: '5m',\n    queryKind: 'rate'\n  });\n}\n\n// ------------------------------------------------------------------\n// Replication.\n// ------------------------------------------------------------------\nconst replLag =\n  pick(mongoSet, ['mongodb_mongod_replset_member_replication_lag']);\nif (replLag) {\n  pushQuery({\n    key: 'replication_lag_seconds',\n    legend: 'Replica member lag seconds',\n    expr:\n      `max by (` +\n      `cluster,node_name,service_name,rs_nm,member,member_name,name,state,rs_state` +\n      `) (${replLag}{${clusterScope}})`,\n    category: 'Replication',\n    unit: 'seconds',\n    semantics:\n      'Replication lag retained with replica/member labels. No universal threshold is assumed.',\n    metricNames: [replLag],\n    queryKind: 'gauge'\n  });\n}\n\nconst oplogHead =\n  pick(mongoSet, ['mongodb_mongod_replset_oplog_head_timestamp']);\nconst oplogTail =\n  pick(mongoSet, ['mongodb_mongod_replset_oplog_tail_timestamp']);\n\nif (oplogHead && oplogTail) {\n  pushQuery({\n    key: 'oplog_window_hours',\n    legend: 'Oplog window hours',\n    expr:\n      `(` +\n      `max by (cluster,node_name,service_name,rs_nm) (` +\n      `${oplogHead}{${clusterScope}})` +\n      ` - ` +\n      `max by (cluster,node_name,service_name,rs_nm) (` +\n      `${oplogTail}{${clusterScope}})` +\n      `) / 3600`,\n    category: 'Replication',\n    unit: 'hours',\n    semantics:\n      'Per-member oplog time window. This is replication context, not backup/PITR proof.',\n    metricNames: [oplogHead, oplogTail],\n    queryKind: 'derived'\n  });\n}\n\n// ------------------------------------------------------------------\n// WiredTiger context.\n// ------------------------------------------------------------------\nconst wtCur =\n  pick(mongoSet, [\n    'mongodb_ss_wt_cache_bytes_currently_in_the_cache',\n    'mongodb_mongod_wiredtiger_cache_bytes'\n  ]);\nconst wtMax =\n  pick(mongoSet, [\n    'mongodb_ss_wt_cache_maximum_bytes_configured',\n    'mongodb_mongod_wiredtiger_cache_max_bytes'\n  ]);\nconst wtDirty =\n  pick(mongoSet, [\n    'mongodb_ss_wt_cache_tracked_dirty_bytes_in_the_cache'\n  ]);\n\nif (wtCur && wtMax) {\n  pushQuery({\n    key: 'wt_cache_utilization_pct',\n    legend: 'WiredTiger cache utilization',\n    expr:\n      `100 * max by (cluster,node_name,service_name,rs_nm) (` +\n      `${wtCur}{${clusterScope}})` +\n      ` / clamp_min(max by (cluster,node_name,service_name,rs_nm) (` +\n      `${wtMax}{${clusterScope}}),1)`,\n    category: 'WiredTiger',\n    unit: 'percent',\n    semantics:\n      'WiredTiger cache occupancy per service. Occupancy alone does not establish pressure.',\n    metricNames: [wtCur, wtMax],\n    queryKind: 'derived'\n  });\n}\n\nif (wtDirty && wtMax) {\n  pushQuery({\n    key: 'wt_cache_dirty_pct_of_max',\n    legend: 'WiredTiger dirty cache percent of max',\n    expr:\n      `100 * max by (cluster,node_name,service_name,rs_nm) (` +\n      `${wtDirty}{${clusterScope}})` +\n      ` / clamp_min(max by (cluster,node_name,service_name,rs_nm) (` +\n      `${wtMax}{${clusterScope}}),1)`,\n    category: 'WiredTiger',\n    unit: 'percent',\n    semantics:\n      'Dirty bytes as percentage of configured cache maximum per service.',\n    metricNames: [wtDirty, wtMax],\n    queryKind: 'derived'\n  });\n}\n\n// ------------------------------------------------------------------\n// Sharding-specific known metrics.\n// ------------------------------------------------------------------\nconst chunks =\n  pick(mongoSet, ['mongodb_shards_collection_chunks_count']);\nif (chunks) {\n  pushQuery({\n    key: 'shard_chunks_count',\n    legend: 'Chunks per shard',\n    expr:\n      `sum by (shard) (` +\n      `max by (database,collection,shard) (` +\n      `${chunks}{${mongosScope}}))`,\n    category: 'Sharding',\n    unit: 'chunks',\n    semantics:\n      'Current chunk count per shard after deduplicating identical database/collection/shard observations across mongos routers. Chunk count alone does not prove data-size balance or shard-key quality.',\n    metricNames: [chunks],\n    queryKind: 'gauge',\n    variability: false,\n    instant: true,\n    range: false\n  });\n\n  pushQuery({\n    key: 'sharded_namespace_count',\n    legend: 'Observed sharded namespace count',\n    expr:\n      `count(` +\n      `max by (database,collection) (` +\n      `${chunks}{${mongosScope}}))`,\n    category: 'Sharding',\n    unit: 'namespaces',\n    semantics:\n      'Current count of database/collection namespaces represented by the exporter chunk metric after deduplicating mongos observations. Snapshot only; does not describe namespace size or shard-key quality.',\n    metricNames: [chunks],\n    queryKind: 'gauge',\n    variability: false,\n    instant: true,\n    range: false\n  });\n}\n\nconst balancer =\n  pick(mongoSet, ['mongodb_mongos_sharding_balancer_enabled']);\nif (balancer) {\n  pushQuery({\n    key: 'balancer_enabled',\n    legend: 'MongoDB balancer enabled',\n    expr:\n      `max by (cluster,node_name,service_name,cl_role) (` +\n      `${balancer}{${clusterScope}})`,\n    category: 'Sharding',\n    unit: 'boolean',\n    semantics:\n      'Balancer enabled metric exposed by mongos. Enabled status does not prove active migrations or successful balancing.',\n    metricNames: [balancer],\n    queryKind: 'gauge',\n    variability: false,\n    instant: true,\n    range: false\n  });\n}\n\n\nconst balancerRunning =\n  pick(mongoSet, [\n    'mongodb_mongos_sharding_chunks_is_balancer_running'\n  ]);\n\nif (balancerRunning) {\n  pushQuery({\n    key: 'balancer_running',\n    legend: 'MongoDB balancer currently running',\n    expr:\n      `max by (node_name,service_name,cl_role) (` +\n      `${balancerRunning}{${mongosScope}})`,\n    category: 'Sharding',\n    unit: 'boolean',\n    semantics:\n      'Current mongos balancer-running snapshot. A value of 1 describes the sampled instant only and does not prove migration success.',\n    metricNames: [balancerRunning],\n    queryKind: 'gauge',\n    variability: false,\n    instant: true,\n    range: false\n  });\n}\n\nconst shardsTotal =\n  pick(mongoSet, [\n    'mongodb_mongos_sharding_shards_total'\n  ]);\n\nif (shardsTotal) {\n  pushQuery({\n    key: 'mongos_shards_total',\n    legend: 'MongoDB shards total',\n    expr: `max(${shardsTotal}{${mongosScope}})`,\n    category: 'Sharding',\n    unit: 'shards',\n    semantics: 'Current shard-count snapshot reported by mongos.',\n    metricNames: [shardsTotal],\n    queryKind: 'gauge',\n    variability: false,\n    instant: true,\n    range: false\n  });\n}\n\nconst shardsDraining =\n  pick(mongoSet, [\n    'mongodb_mongos_sharding_shards_draining_total'\n  ]);\n\nif (shardsDraining) {\n  pushQuery({\n    key: 'mongos_shards_draining_total',\n    legend: 'MongoDB draining shards total',\n    expr: `max(${shardsDraining}{${mongosScope}})`,\n    category: 'Sharding',\n    unit: 'shards',\n    semantics:\n      'Current mongos snapshot of shards marked draining. This is state context, not a diagnosis.',\n    metricNames: [shardsDraining],\n    queryKind: 'gauge',\n    variability: false,\n    instant: true,\n    range: false\n  });\n}\n\nconst moveChunkStarted =\n  pick(mongoSet, [\n    'mongodb_ss_shardingStatistics_countDonorMoveChunkStarted'\n  ]);\n\nconst moveChunkCommitted =\n  pick(mongoSet, [\n    'mongodb_ss_shardingStatistics_countDonorMoveChunkCommitted'\n  ]);\n\nconst moveChunkAborted =\n  pick(mongoSet, [\n    'mongodb_ss_shardingStatistics_countDonorMoveChunkAborted'\n  ]);\n\nfor (const [metric, key, legend, semantics] of [\n  [\n    moveChunkStarted,\n    'move_chunk_started_increase_7d',\n    'Donor moveChunk started counter increase - 7d',\n    'Seven-day increase of the local donor moveChunk-started counter per mongod service. Summing member-local counter increases is observational and is not asserted to equal unique logical migrations.'\n  ],\n  [\n    moveChunkCommitted,\n    'move_chunk_committed_increase_7d',\n    'Donor moveChunk committed counter increase - 7d',\n    'Seven-day increase of the local donor moveChunk-committed counter per mongod service. It does not prove every started migration completed successfully.'\n  ],\n  [\n    moveChunkAborted,\n    'move_chunk_aborted_increase_7d',\n    'Donor moveChunk aborted counter increase - 7d',\n    'Seven-day increase of the local donor moveChunk-aborted counter per mongod service.'\n  ]\n]) {\n  if (!metric) continue;\n\n  pushQuery({\n    key,\n    legend,\n    expr:\n      `sum by (node_name,service_name,rs_nm) (` +\n      `increase(${metric}{${clusterScope}}[7d]))`,\n    category: 'Sharding Activity',\n    unit: 'counter_increase',\n    semantics,\n    metricNames: [metric],\n    queryKind: 'counter_increase',\n    variability: false,\n    instant: true,\n    range: false\n  });\n}\n\nconst rangeDeleterTasks =\n  pick(mongoSet, [\n    'mongodb_ss_shardingStatistics_rangeDeleterTasks'\n  ]);\n\nif (rangeDeleterTasks) {\n  pushQuery({\n    key: 'range_deleter_tasks_current',\n    legend: 'Range deleter tasks current',\n    expr:\n      `max by (node_name,service_name,rs_nm) (` +\n      `${rangeDeleterTasks}{${clusterScope}})`,\n    category: 'Sharding Activity',\n    unit: 'tasks',\n    semantics:\n      'Current range-deleter task count per service. Non-zero activity is not inherently a problem.',\n    metricNames: [rangeDeleterTasks],\n    queryKind: 'gauge',\n    variability: false,\n    instant: true,\n    range: false\n  });\n}\n\nconst rangeDocsDeleted =\n  pick(mongoSet, [\n    'mongodb_ss_shardingStatistics_countDocsDeletedByRangeDeleter'\n  ]);\n\nconst rangeBytesDeleted =\n  pick(mongoSet, [\n    'mongodb_ss_shardingStatistics_countBytesDeletedByRangeDeleter'\n  ]);\n\nfor (const [metric, key, legend, unit, semantics] of [\n  [\n    rangeDocsDeleted,\n    'range_deleter_docs_increase_7d',\n    'Range deleter documents counter increase - 7d',\n    'documents',\n    'Seven-day increase of the local range-deleter documents-deleted counter. This indicates cleanup activity, not by itself a fault.'\n  ],\n  [\n    rangeBytesDeleted,\n    'range_deleter_bytes_increase_7d',\n    'Range deleter bytes counter increase - 7d',\n    'bytes',\n    'Seven-day increase of the local range-deleter bytes-deleted counter. This indicates cleanup activity, not by itself a fault.'\n  ]\n]) {\n  if (!metric) continue;\n\n  pushQuery({\n    key,\n    legend,\n    expr:\n      `sum by (node_name,service_name,rs_nm) (` +\n      `increase(${metric}{${clusterScope}}[7d]))`,\n    category: 'Sharding Activity',\n    unit,\n    semantics,\n    metricNames: [metric],\n    queryKind: 'counter_increase',\n    variability: false,\n    instant: true,\n    range: false\n  });\n}\n\nconst unfinishedMigration =\n  pick(mongoSet, [\n    'mongodb_ss_shardingStatistics_unfinishedMigrationFromPreviousPrimary'\n  ]);\n\nif (unfinishedMigration) {\n  pushQuery({\n    key: 'unfinished_migration_from_previous_primary',\n    legend: 'Unfinished migration from previous PRIMARY',\n    expr:\n      `max by (node_name,service_name,rs_nm) (` +\n      `${unfinishedMigration}{${clusterScope}})`,\n    category: 'Sharding Activity',\n    unit: 'boolean_or_count',\n    semantics:\n      'Current unfinishedMigrationFromPreviousPrimary value per service. No universal threshold is assumed.',\n    metricNames: [unfinishedMigration],\n    queryKind: 'gauge',\n    variability: false,\n    instant: true,\n    range: false\n  });\n}\n\n// Current per-shard dbStats raw snapshots.\n// The exporter encodes shard identity into the metric name.\nconst selectedShardNames =\n  Array.isArray(cfg.selected_shard_names)\n    ? cfg.selected_shard_names.filter(Boolean)\n    : [];\n\nfunction metricShardToken(shard) {\n  return String(shard).replace(/[^A-Za-z0-9]/g, '_');\n}\n\nfunction findRawDbStatsMetric(shard, suffix) {\n  const token = metricShardToken(shard);\n  const prefix = `mongodb_dbstats_raw_${token}_`;\n\n  return mongoNames.find(name =>\n    name.startsWith(prefix) &&\n    name.endsWith(`_${suffix}`)\n  ) || null;\n}\n\nfor (const shard of selectedShardNames) {\n  for (const [suffix, key, legend, unit, semantics] of [\n    [\n      'dataSize',\n      'shard_dbstats_data_size_bytes',\n      'Shard dbStats dataSize snapshot',\n      'bytes',\n      'Current MongoDB dbStats raw per-shard dataSize snapshot as exported by PMM. This is not filesystem usage and does not establish shard-key quality.'\n    ],\n    [\n      'storageSize',\n      'shard_dbstats_storage_size_bytes',\n      'Shard dbStats storageSize snapshot',\n      'bytes',\n      'Current MongoDB dbStats raw per-shard storageSize snapshot as exported by PMM. This is distinct from filesystem utilization.'\n    ],\n    [\n      'indexSize',\n      'shard_dbstats_index_size_bytes',\n      'Shard dbStats indexSize snapshot',\n      'bytes',\n      'Current MongoDB dbStats raw per-shard indexSize snapshot as exported by PMM.'\n    ],\n    [\n      'objects',\n      'shard_dbstats_objects',\n      'Shard dbStats object count snapshot',\n      'objects',\n      'Current MongoDB dbStats raw per-shard object-count snapshot as exported by PMM.'\n    ]\n  ]) {\n    const metric = findRawDbStatsMetric(shard, suffix);\n    if (!metric) continue;\n\n    pushQuery({\n      key,\n      legend,\n      expr:\n        `sum(max by (database) (` +\n        `${metric}{${mongosScope}}))`,\n      category: 'Shard Data Snapshot',\n      unit,\n      semantics,\n      metricNames: [metric],\n      queryKind: 'gauge',\n      variability: false,\n      instant: true,\n      range: false,\n      staticLabels: { shard }\n    });\n  }\n}\n\n// ------------------------------------------------------------------\n// Dynamic sharding capability metrics.\n// Performance-safe mode: inventory names are retained as capability\n// evidence, but unknown metrics are NOT queried across seven days.\n// This avoids high-cardinality raw series explosions.\n// ------------------------------------------------------------------\nconst dynamicPatterns = [\n  /^mongodb_shards_/,\n  /^mongodb_mongos_sharding_/,\n  /balancer/i,\n  /chunk/i,\n  /jumbo/i,\n  /migration/i,\n  /range.*delet/i,\n  /dbstats/i\n];\n\nconst alreadyUsed = new Set(\n  descriptors.flatMap(d => d.metric_names || [])\n);\n\nconst dynamicNames = mongoNames\n  .filter(name =>\n    dynamicPatterns.some(re => re.test(name)) &&\n    !alreadyUsed.has(name)\n  )\n  .slice(0, 100);\n\n// ------------------------------------------------------------------\n// Host metrics per node.\n// ------------------------------------------------------------------\nif (hasNode('node_cpu_seconds_total')) {\n  pushQuery({\n    key: 'host_cpu_logical_cores',\n    legend: 'Host logical CPU count',\n    expr:\n      `count by (node_name) (` +\n      `count by (node_name,cpu) (` +\n      `node_cpu_seconds_total{${nodeScope}}))`,\n    category: 'Host',\n    source: 'node',\n    unit: 'logical_cpus',\n    semantics: 'Logical CPU count per monitored cluster node.',\n    metricNames: ['node_cpu_seconds_total'],\n    queryKind: 'gauge',\n    variability: false\n  });\n\n  pushQuery({\n    key: 'host_cpu_utilization_pct',\n    legend: 'Host CPU utilization',\n    expr:\n      `100 * (1 - avg by (node_name) (` +\n      `rate(node_cpu_seconds_total{${nodeScope},mode=\"idle\"}[5m])))`,\n    category: 'Host',\n    source: 'node',\n    unit: 'percent',\n    semantics:\n      'Approximate non-idle CPU utilization per node; no saturation threshold is assumed.',\n    metricNames: ['node_cpu_seconds_total'],\n    rateWindow: '5m',\n    queryKind: 'derived'\n  });\n}\n\nif (hasNode(\n  'node_memory_MemAvailable_bytes',\n  'node_memory_MemTotal_bytes'\n)) {\n  pushQuery({\n    key: 'host_memory_utilization_pct',\n    legend: 'Host memory utilization',\n    expr:\n      `100 * (1 - max by (node_name) (` +\n      `node_memory_MemAvailable_bytes{${nodeScope}})` +\n      ` / clamp_min(max by (node_name) (` +\n      `node_memory_MemTotal_bytes{${nodeScope}}),1))`,\n    category: 'Host',\n    source: 'node',\n    unit: 'percent',\n    semantics:\n      'MemAvailable-based host memory utilization; not proof of memory pressure.',\n    metricNames: [\n      'node_memory_MemAvailable_bytes',\n      'node_memory_MemTotal_bytes'\n    ],\n    queryKind: 'derived'\n  });\n}\n\nif (hasNode('node_disk_io_time_seconds_total')) {\n  pushQuery({\n    key: 'disk_busy_pct_max_device',\n    legend: 'Disk busy — busiest device',\n    expr:\n      `100 * max by (node_name) (` +\n      `rate(node_disk_io_time_seconds_total{${nodeScope},device!~\"^(loop|ram|sr|fd).*\"}[5m]))`,\n    category: 'Host',\n    source: 'node',\n    unit: 'percent',\n    semantics:\n      'Busy-time percentage of the busiest included block device; not IOPS, bandwidth, or latency.',\n    metricNames: ['node_disk_io_time_seconds_total'],\n    rateWindow: '5m',\n    queryKind: 'derived'\n  });\n}\n\nif (hasNode(\n  'node_filesystem_avail_bytes',\n  'node_filesystem_size_bytes'\n)) {\n  pushQuery({\n    key: 'filesystem_used_pct_max',\n    legend: 'Filesystem used — fullest filesystem',\n    expr:\n      `100 * max by (node_name) (` +\n      `(node_filesystem_size_bytes{${nodeScope},fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs\"}` +\n      ` - node_filesystem_avail_bytes{${nodeScope},fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs\"})` +\n      ` / clamp_min(node_filesystem_size_bytes{${nodeScope},fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs\"},1))`,\n    category: 'Host',\n    source: 'node',\n    unit: 'percent',\n    semantics:\n      'Fullest included filesystem utilization per monitored node.',\n    metricNames: [\n      'node_filesystem_avail_bytes',\n      'node_filesystem_size_bytes'\n    ],\n    queryKind: 'derived'\n  });\n}\n\nconst shardingCapabilityNames = mongoNames.filter(name =>\n  dynamicPatterns.some(re => re.test(name))\n);\n\nconst selectedMetricNames =\n  new Set(descriptors.flatMap(d => d.metric_names || []));\n\nreturn [{\n  json: {\n    ...cfg,\n    metric_inventory: {\n      mongodb_metric_count: mongoNames.length,\n      node_metric_count: nodeNames.length,\n      mongodb_metric_names: mongoNames,\n      node_metric_names: nodeNames,\n      selected_query_count: descriptors.length,\n      selected_source_metric_names:\n        [...selectedMetricNames].sort(),\n      sharding_capability_metric_names:\n        shardingCapabilityNames,\n      dynamic_sharding_metric_names:\n        dynamicNames,\n      has_shards_collector_metric:\n        mongoSet.has('mongodb_shards_collection_chunks_count'),\n      has_balancer_metric:\n        mongoSet.has('mongodb_mongos_sharding_balancer_enabled'),\n\n      has_balancer_running_metric:\n        mongoSet.has('mongodb_mongos_sharding_chunks_is_balancer_running'),\n\n      has_dbstats_metrics:\n        mongoNames.some(x => /mongodb_.*dbstats/i.test(x)),\n\n      has_raw_shard_dbstats_data_size:\n        selectedShardNames.some(shard =>\n          Boolean(findRawDbStatsMetric(shard, 'dataSize'))\n        ),\n\n      has_collstats_metrics:\n        mongoNames.some(x => /mongodb_.*collstats/i.test(x)),\n\n      has_indexstats_metrics:\n        mongoNames.some(x => /mongodb_.*indexstats/i.test(x)),\n\n      has_move_chunk_activity_metrics:\n        Boolean(moveChunkStarted || moveChunkCommitted || moveChunkAborted),\n\n      has_range_deleter_activity_metrics:\n        Boolean(rangeDeleterTasks || rangeDocsDeleted || rangeBytesDeleted),\n\n      has_unfinished_migration_metric:\n        Boolean(unfinishedMigration),\n\n      has_jumbo_chunk_state_metric:\n        mongoNames.some(x =>\n          /mongodb_.*jumbo.*(chunks|count|total|state)/i.test(x) &&\n          !/clearJumboFlag/i.test(x)\n        ),\n\n      migration_metric_names:\n        mongoNames.filter(x =>\n          /shardingStatistics_.*MoveChunk|unfinishedMigration/i.test(x)\n        ),\n\n      jumbo_metric_names:\n        mongoNames.filter(x => /jumbo/i.test(x)),\n\n      range_deletion_metric_names:\n        mongoNames.filter(x =>\n          /shardingStatistics_.*RangeDeleter/i.test(x)\n        )\n    },\n    query_metadata: descriptors,\n    query_url:\n      `${String(cfg.pmm_base_url).replace(/\\/$/, '')}` +\n      '/graph/api/ds/query?ds_type=prometheus&requestId=MONGOCLUSTER7D',\n    query_body: {\n      queries,\n      from: cfg.from_ms,\n      to: cfg.to_ms\n    }\n  }\n}];"
