    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $json;\nconst cfg = $('Build Analysis Batches').item.json;\nconst results = response.results || {};\n\nconst metaList =\n  Array.isArray(cfg.query_metadata)\n    ? cfg.query_metadata\n    : [];\n\nconst metaByRef =\n  Object.fromEntries(metaList.map(m => [m.refId, m]));\n\nfunction num(value) {\n  if (value === null || value === undefined) return null;\n  if (typeof value === 'string' && value.trim() === '') return null;\n  const x = Number(value);\n  return Number.isFinite(x) ? x : null;\n}\n\nfunction round(value, decimals = 2) {\n  if (!Number.isFinite(value)) return null;\n  return Number(value.toFixed(decimals));\n}\n\nfunction quantileSorted(sorted, p) {\n  if (!sorted.length) return null;\n\n  const pos = (p / 100) * (sorted.length - 1);\n  const lo = Math.floor(pos);\n  const hi = Math.ceil(pos);\n\n  if (lo === hi) return sorted[lo];\n\n  return (\n    sorted[lo] +\n    (sorted[hi] - sorted[lo]) * (pos - lo)\n  );\n}\n\nfunction stableLabels(labels) {\n  if (!labels || typeof labels !== 'object') return {};\n\n  const keys = Object.keys(labels).sort();\n  const out = {};\n\n  for (const key of keys) out[key] = labels[key];\n\n  return out;\n}\n\n// Aggregate duplicate timestamps as we extract them.\n// Map value = maximum numeric value seen for that same series/timestamp.\nconst seriesBuckets = new Map();\n\nconst extractionErrors = [];\nlet skippedPoints = 0;\n\nfor (const [refId, result] of Object.entries(results)) {\n  const meta = metaByRef[refId];\n  const frames =\n    Array.isArray(result?.frames)\n      ? result.frames\n      : [];\n\n  if (!frames.length) {\n    extractionErrors.push({\n      ref_id: refId,\n      metric_key: meta?.metric_key || null,\n      error: result?.error || 'No Grafana frames returned'\n    });\n    continue;\n  }\n\n  for (let frameIndex = 0; frameIndex < frames.length; frameIndex++) {\n    const frame = frames[frameIndex];\n    const fields = frame?.schema?.fields || [];\n    const values = frame?.data?.values || [];\n\n    const timeIndex =\n      fields.findIndex(f => f?.type === 'time');\n\n    if (timeIndex < 0) {\n      extractionErrors.push({\n        ref_id: refId,\n        metric_key: meta?.metric_key || null,\n        frame_index: frameIndex,\n        error: 'Frame is missing a time field'\n      });\n      continue;\n    }\n\n    const timestamps = values[timeIndex] || [];\n\n    for (let valueIndex = 0; valueIndex < fields.length; valueIndex++) {\n      const field = fields[valueIndex];\n\n      if (field?.type !== 'number') continue;\n\n      const numericValues =\n        values[valueIndex] || [];\n\n      const labels = stableLabels(\n        field.labels ||\n        field.config?.labels ||\n        {}\n      );\n\n      const identity =\n        `${refId}|${JSON.stringify(labels)}`;\n\n      let bucket = seriesBuckets.get(identity);\n\n      if (!bucket) {\n        bucket = {\n          ref_id: refId,\n          labels,\n          points_by_ts: new Map(),\n          raw_numeric_points: 0,\n          duplicate_timestamp_count: 0\n        };\n\n        seriesBuckets.set(identity, bucket);\n      }\n\n      const limit =\n        Math.min(timestamps.length, numericValues.length);\n\n      for (let i = 0; i < limit; i++) {\n        const ts = num(timestamps[i]);\n        const value = num(numericValues[i]);\n\n        if (ts === null || value === null) {\n          skippedPoints++;\n          continue;\n        }\n\n        bucket.raw_numeric_points++;\n\n        if (bucket.points_by_ts.has(ts)) {\n          bucket.duplicate_timestamp_count++;\n\n          if (value > bucket.points_by_ts.get(ts)) {\n            bucket.points_by_ts.set(ts, value);\n          }\n        } else {\n          bucket.points_by_ts.set(ts, value);\n        }\n      }\n    }\n  }\n}\n\nfunction analyzeSeries(series) {\n  const meta =\n    metaByRef[series.ref_id] || {\n      refId: series.ref_id,\n      metric_key: series.ref_id,\n      legend: series.ref_id,\n      category: 'Unclassified',\n      source: 'unknown',\n      unit: 'unknown',\n      semantics: null,\n      metric_names: [],\n      rate_window: null,\n      query_kind: 'unknown',\n      classify_variability: true\n    };\n\n  const points =\n    [...series.points_by_ts.entries()]\n      .map(([timestamp_ms, value]) => ({\n        timestamp_ms: Number(timestamp_ms),\n        value\n      }))\n      .sort((a, b) =>\n        a.timestamp_ms - b.timestamp_ms\n      );\n\n  if (!points.length) {\n    return {\n      ref_id: series.ref_id,\n      metric_key: meta.metric_key,\n      display_name: meta.legend,\n      category: meta.category,\n      source: meta.source,\n      unit: meta.unit,\n      error: 'No valid numeric points'\n    };\n  }\n\n  const values = points.map(p => p.value);\n  const sortedValues =\n    [...values].sort((a, b) => a - b);\n\n  let sum = 0;\n  for (const v of values) sum += v;\n\n  const min = sortedValues[0];\n  const max = sortedValues[sortedValues.length - 1];\n  const avg = sum / values.length;\n\n  const p50 = quantileSorted(sortedValues, 50);\n  const p95 = quantileSorted(sortedValues, 95);\n  const p99 = quantileSorted(sortedValues, 99);\n\n  const configuredIntervalMs =\n    Number(cfg.sampling_interval_ms || 300000);\n\n  const requestedRangeMs =\n    Math.max(\n      0,\n      Number(cfg.to_ms || 0) -\n      Number(cfg.from_ms || 0)\n    );\n\n  const maxDataPoints =\n    Math.max(\n      2,\n      Number(cfg.max_data_points || 1200)\n    );\n\n  const minStepByPointBudgetMs =\n    requestedRangeMs > 0\n      ? requestedRangeMs / (maxDataPoints - 1)\n      : configuredIntervalMs;\n\n  const pointBudgetAlignedStepMs =\n    Math.max(\n      configuredIntervalMs,\n      Math.ceil(\n        minStepByPointBudgetMs /\n        configuredIntervalMs\n      ) * configuredIntervalMs\n    );\n\n  const expectedIntervalMs =\n    pointBudgetAlignedStepMs;\n\n  let missingIntervalCount = 0;\n  let estimatedMissingSamples = 0;\n  const missingIntervals = [];\n\n  if (points.length > 1 && meta.query_kind !== 'identity') {\n    for (let i = 1; i < points.length; i++) {\n      const gap =\n        points[i].timestamp_ms -\n        points[i - 1].timestamp_ms;\n\n      if (gap > expectedIntervalMs * 1.8) {\n        missingIntervalCount++;\n\n        const missing =\n          Math.max(\n            0,\n            Math.round(gap / expectedIntervalMs) - 1\n          );\n\n        estimatedMissingSamples += missing;\n\n        if (missingIntervals.length < 10) {\n          missingIntervals.push({\n            from:\n              new Date(\n                points[i - 1].timestamp_ms\n              ).toISOString(),\n            to:\n              new Date(\n                points[i].timestamp_ms\n              ).toISOString(),\n            gap_minutes:\n              round(gap / 60000),\n            estimated_missing_samples:\n              missing\n          });\n        }\n      }\n    }\n  }\n\n  const expectedSamples =\n    points.length === 1\n      ? 1\n      : Math.floor(\n          (\n            points[points.length - 1].timestamp_ms -\n            points[0].timestamp_ms\n          ) / expectedIntervalMs\n        ) + 1;\n\n  const completenessPct =\n    expectedSamples > 0\n      ? Math.min(\n          100,\n          (points.length / expectedSamples) * 100\n        )\n      : 100;\n\n  let variability = 'not_applicable';\n\n  if (\n    meta.classify_variability !== false &&\n    values.length > 1\n  ) {\n    variability = 'stable_baseline';\n\n    if (avg > 0 && p99 > avg * 5) {\n      variability = 'very_bursty_baseline';\n    } else if (avg > 0 && p95 > avg * 3) {\n      variability = 'bursty_baseline';\n    } else if (avg > 0 && p95 > avg * 1.8) {\n      variability = 'moderately_variable_baseline';\n    } else if (\n      p99 > 0 &&\n      max / p99 >= 3\n    ) {\n      variability =\n        'stable_baseline_with_rare_high_excursions';\n    }\n  }\n\n  let quality = 'good';\n\n  if (completenessPct < 80) {\n    quality = 'poor';\n  } else if (\n    completenessPct < 95 ||\n    missingIntervalCount > 0\n  ) {\n    quality = 'warning';\n  }\n\n  // Distinct values are only required for replica-state transition\n  // analysis. Do not sort continuous values for every metric.\n  let distinctValues = [];\n\n  if (\n    meta.query_kind === 'state' ||\n    meta.query_kind === 'identity'\n  ) {\n    distinctValues =\n      [...new Set(values)]\n        .sort((a, b) => a - b)\n        .slice(0, 20)\n        .map(v => round(v));\n  }\n\n  return {\n    ref_id: series.ref_id,\n    metric_key: meta.metric_key,\n    display_name: meta.legend,\n    category: meta.category,\n    source: meta.source,\n    unit: meta.unit,\n    query_kind: meta.query_kind,\n    rate_window: meta.rate_window,\n    source_metric_names:\n      meta.metric_names || [],\n    semantics: meta.semantics,\n    labels: {\n      ...(series.labels || {}),\n      ...(meta.static_labels || {})\n    },\n\n    period: {\n      start:\n        new Date(\n          points[0].timestamp_ms\n        ).toISOString(),\n      end:\n        new Date(\n          points[points.length - 1].timestamp_ms\n        ).toISOString(),\n      timezone_for_buckets:\n        cfg.timezone || 'UTC',\n      configured_interval_minutes:\n        round(configuredIntervalMs / 60000),\n\n      effective_expected_interval_minutes:\n        round(expectedIntervalMs / 60000),\n\n      point_budget_limited:\n        expectedIntervalMs > configuredIntervalMs,\n\n      max_data_points:\n        maxDataPoints,\n\n      samples: points.length,\n      expected_samples: expectedSamples,\n      completeness_pct: round(completenessPct)\n    },\n\n    summary: {\n      min: round(min),\n      avg: round(avg),\n      p50: round(p50),\n      p95: round(p95),\n      p99: round(p99),\n      max: round(max),\n      first: round(points[0].value),\n      last:\n        round(points[points.length - 1].value),\n      distinct_values: distinctValues,\n      p95_to_avg_ratio:\n        avg ? round(p95 / avg) : null,\n      p99_to_avg_ratio:\n        avg ? round(p99 / avg) : null,\n      max_to_p99_ratio:\n        p99 ? round(max / p99) : null\n    },\n\n    pattern: {\n      baseline_variability: variability\n    },\n\n    // Cluster report does not use top-point arrays. Omitting them\n    // materially reduces CPU, sorting, and serialized output size.\n    highest_points: [],\n\n    data_quality: {\n      status: quality,\n      raw_points: series.raw_numeric_points,\n      points_after_same_series_deduplication:\n        points.length,\n      duplicate_timestamp_count_same_series:\n        series.duplicate_timestamp_count,\n      missing_interval_count:\n        missingIntervalCount,\n      estimated_missing_samples:\n        estimatedMissingSamples,\n      missing_intervals:\n        missingIntervals\n    }\n  };\n}\n\nconst metrics = [];\n\nfor (const series of seriesBuckets.values()) {\n  metrics.push(analyzeSeries(series));\n}\n\nmetrics.sort((a, b) => {\n  const ca = String(a.category || '');\n  const cb = String(b.category || '');\n\n  if (ca !== cb) return ca.localeCompare(cb);\n\n  return String(a.display_name || '')\n    .localeCompare(\n      String(b.display_name || '')\n    );\n});\n\nreturn {\n  json: {\n    report_type:\n      'MongoDB sharded-cluster 7-day PMM technical workload and health analysis',\n\n    batch:\n      cfg.batch || null,\n\n    target: {\n      selected_cluster_signature:\n        cfg.selected_cluster_signature || null,\n\n      selected_cluster_name:\n        cfg.selected_cluster_name || null,\n\n      selected_mongos:\n        cfg.selected_mongos || null,\n\n      selected_mongos_service_names:\n        Array.isArray(cfg.selected_mongos_service_names)\n          ? cfg.selected_mongos_service_names\n          : [],\n\n      selected_shard_names:\n        Array.isArray(cfg.selected_shard_names)\n          ? cfg.selected_shard_names\n          : [],\n\n      shard_membership_available:\n        Boolean(cfg.shard_membership_available),\n\n      expected_service_count:\n        Number(cfg.expected_service_count || 0),\n\n      expected_replica_set_count:\n        Number(cfg.expected_replica_set_count || 0),\n\n      expected_mongos_count:\n        Number(cfg.expected_mongos_count || 0),\n\n      cluster_services:\n        Array.isArray(cfg.cluster_services)\n          ? cfg.cluster_services\n          : [],\n\n      selected_node_names:\n        Array.isArray(cfg.selected_node_names)\n          ? cfg.selected_node_names\n          : [],\n\n      selected_service_names:\n        Array.isArray(cfg.selected_service_names)\n          ? cfg.selected_service_names\n          : [],\n\n      topology_selection_snapshot:\n        cfg.topology_selection_snapshot || null,\n\n      service_name_regex:\n        cfg.service_name_regex,\n\n      resolved_node_name_regex:\n        cfg.resolved_node_name_regex,\n\n      timezone:\n        cfg.timezone\n    },\n\n    requested_period: {\n      start: cfg.from_iso,\n      end: cfg.to_iso,\n      lookback_days: cfg.lookback_days,\n      requested_sampling_interval:\n        cfg.sampling_interval\n    },\n\n    metric_inventory:\n      cfg.metric_inventory,\n\n    extraction: {\n      query_count:\n        metaList.length,\n      result_keys:\n        Object.keys(results),\n      analyzed_series_count:\n        seriesBuckets.size,\n      non_numeric_or_null_points_skipped:\n        skippedPoints,\n      extraction_errors:\n        extractionErrors,\n\n      performance_mode: {\n        repeated_percentile_sorts: false,\n        hourly_bucket_profiles: false,\n        highest_point_arrays: false,\n        dynamic_raw_sharding_range_queries: false\n      }\n    },\n\n    metrics\n  }\n};"
      },
