    {
      "parameters": {
        "jsCode": "\nconst cfg = $json;\n\nconst allQueries =\n  Array.isArray(cfg.query_body?.queries)\n    ? cfg.query_body.queries\n    : [];\n\nconst allMeta =\n  Array.isArray(cfg.query_metadata)\n    ? cfg.query_metadata\n    : [];\n\nconst metaByRef =\n  new Map(allMeta.map(m => [m.refId, m]));\n\nfunction clean(v) {\n  return v === undefined || v === null\n    ? ''\n    : String(v).trim();\n}\n\nfunction normalizeRole(v) {\n  return clean(v)\n    .toLowerCase()\n    .replace(/[ _-]/g, '');\n}\n\nfunction regexEscape(value) {\n  return String(value ?? '')\n    .replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nfunction promqlString(value) {\n  return String(value ?? '')\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\n/g, '');\n}\n\nfunction exactRegex(values) {\n  const arr =\n    [...new Set(\n      values\n        .filter(Boolean)\n        .map(String)\n    )];\n\n  return arr.length\n    ? `^(?:${arr.map(regexEscape).join('|')})$`\n    : '^$';\n}\n\nconst globalServiceRegexRaw =\n  cfg.service_name_regex || '^$';\n\nconst globalNodeRegexRaw =\n  cfg.resolved_node_name_regex || '^$';\n\nconst globalServiceRegexPromQL =\n  promqlString(globalServiceRegexRaw);\n\nconst globalNodeRegexPromQL =\n  promqlString(globalNodeRegexRaw);\n\nconst clusterServices =\n  Array.isArray(cfg.cluster_services)\n    ? cfg.cluster_services\n    : [];\n\nconst selectedShardNames =\n  Array.isArray(cfg.selected_shard_names)\n    ? cfg.selected_shard_names\n    : [];\n\nconst selectedMongosNames =\n  Array.isArray(cfg.selected_mongos_service_names)\n    ? cfg.selected_mongos_service_names\n    : [];\n\nconst batches = [];\n\nfunction addBatch({\n  id,\n  type,\n  label,\n  services,\n  includeCategories,\n  keepGlobalScope = false,\n  replicaSet = null\n}) {\n  const serviceNames =\n    [...new Set(\n      (services || [])\n        .map(s => s.service_name)\n        .filter(Boolean)\n    )];\n\n  const nodeNames =\n    [...new Set(\n      (services || [])\n        .map(s => s.node_name)\n        .filter(Boolean)\n    )];\n\n  const serviceRegexRaw =\n    exactRegex(serviceNames);\n\n  const nodeRegexRaw =\n    exactRegex(nodeNames);\n\n  const serviceRegexPromQL =\n    promqlString(serviceRegexRaw);\n\n  const nodeRegexPromQL =\n    promqlString(nodeRegexRaw);\n\n  const selectedMeta =\n    allMeta.filter(m =>\n      includeCategories.has(m.category)\n    );\n\n  const selectedRefs =\n    new Set(selectedMeta.map(m => m.refId));\n\n  const selectedQueries =\n    allQueries\n      .filter(q => selectedRefs.has(q.refId))\n      .map(q => {\n        const copy = JSON.parse(JSON.stringify(q));\n\n        if (!keepGlobalScope) {\n          copy.expr =\n            String(copy.expr || '')\n              .split(globalServiceRegexPromQL)\n              .join(serviceRegexPromQL)\n              .split(globalNodeRegexPromQL)\n              .join(nodeRegexPromQL);\n        }\n\n        copy.requestId =\n          `MONGOCLUSTER-${id}-${copy.refId}`;\n\n        return copy;\n      });\n\n  batches.push({\n    ...cfg,\n\n    batch: {\n      id,\n      type,\n      label,\n      replica_set: replicaSet,\n      service_names: serviceNames,\n      node_names: nodeNames,\n      service_count: serviceNames.length,\n      node_count: nodeNames.length,\n      query_count: selectedQueries.length,\n      keep_global_scope: keepGlobalScope\n    },\n\n    batch_service_name_regex:\n      serviceRegexRaw,\n\n    batch_node_name_regex:\n      nodeRegexRaw,\n\n    query_metadata:\n      selectedMeta,\n\n    batch_query_url:\n      `${String(cfg.pmm_base_url).replace(/\\/$/, '')}` +\n      `/graph/api/ds/query?ds_type=prometheus&requestId=${encodeURIComponent(id)}`,\n\n    batch_query_body: {\n      queries: selectedQueries,\n      from: cfg.from_ms,\n      to: cfg.to_ms\n    }\n  });\n}\n\nconst rsCategories =\n  new Set([\n    'Topology',\n    'Workload',\n    'Latency',\n    'Connections',\n    'Network',\n    'Replication',\n    'WiredTiger',\n    'Host'\n  ]);\n\nconst mongosCategories =\n  new Set([\n    'Topology',\n    'Workload',\n    'Latency',\n    'Connections',\n    'Network',\n    'Host'\n  ]);\n\nconst clusterMetaCategories =\n  new Set([\n    'Sharding',\n    'Sharding Activity',\n    'Shard Data Snapshot'\n  ]);\n\n// ---------------------------------------------------------------\n// Data shard replica-set batches.\n// ---------------------------------------------------------------\nfor (const shard of selectedShardNames) {\n  const services =\n    clusterServices.filter(s =>\n      s.replica_set === shard\n    );\n\n  if (!services.length) continue;\n\n  addBatch({\n    id: `rs-${shard}`,\n    type: 'replica_set',\n    label: `Replica set ${shard}`,\n    services,\n    includeCategories: rsCategories,\n    replicaSet: shard\n  });\n}\n\n// ---------------------------------------------------------------\n// Explicit config-server replica-set batches.\n// Never infer config servers from \"not a shard\".\n// ---------------------------------------------------------------\nconst configByRs = new Map();\n\nfor (const svc of clusterServices) {\n  const role =\n    normalizeRole(\n      svc.cl_role ||\n      svc.cluster_role\n    );\n\n  if (\n    role !== 'configsvr' &&\n    role !== 'configserver'\n  ) {\n    continue;\n  }\n\n  const rs =\n    svc.replica_set ||\n    'configsvr-unresolved';\n\n  if (!configByRs.has(rs)) {\n    configByRs.set(rs, []);\n  }\n\n  configByRs.get(rs).push(svc);\n}\n\nfor (const [rs, services] of configByRs.entries()) {\n  addBatch({\n    id: `config-${rs}`,\n    type: 'config_server_replica_set',\n    label: `Config server replica set ${rs}`,\n    services,\n    includeCategories: rsCategories,\n    replicaSet: rs\n  });\n}\n\n// ---------------------------------------------------------------\n// mongos layer batch.\n// ---------------------------------------------------------------\nconst mongosServices =\n  clusterServices.filter(s =>\n    selectedMongosNames.includes(\n      s.service_name\n    )\n  );\n\nif (mongosServices.length) {\n  addBatch({\n    id: 'mongos-layer',\n    type: 'mongos',\n    label: 'mongos routing layer',\n    services: mongosServices,\n    includeCategories: mongosCategories\n  });\n}\n\n// ---------------------------------------------------------------\n// Cluster metadata/sharding batch.\n// Keep original assembled cluster scopes because these queries\n// intentionally need the full mongos/shard context.\n// ---------------------------------------------------------------\naddBatch({\n  id: 'cluster-meta',\n  type: 'cluster_metadata',\n  label: 'Cluster sharding metadata',\n  services: clusterServices,\n  includeCategories: clusterMetaCategories,\n  keepGlobalScope: true\n});\n\nif (!batches.length) {\n  throw new Error(\n    'No analysis batches could be constructed from the assembled MongoDB cluster.'\n  );\n}\n\nreturn batches.map(x => ({ json: x }));\n"
      },
