    {
      "parameters": {
        "jsCode": "const selection = String($json.selected_cluster || '').trim();\n\nif (!selection) {\n  throw new Error('No mongos anchor was selected.');\n}\n\nconst cfg = $('PMM Connection Config').first().json;\nconst selector = $('Build Cluster Selection Form').first().json;\nconst resolved = selector?.selection_map?.[selection];\n\nif (!resolved?.selected_mongos?.service_name) {\n  throw new Error(`Selected mongos anchor could not be resolved: ${selection}`);\n}\n\nfunction escapeRegex(value) {\n  return String(value).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nconst selectedMongos = resolved.selected_mongos;\nconst allMongos =\n  Array.isArray(resolved.all_mongos_services)\n    ? resolved.all_mongos_services\n    : [selectedMongos];\n\nconst allServices =\n  Array.isArray(resolved.all_services)\n    ? resolved.all_services\n    : [selectedMongos];\n\nconst allMongosNames =\n  [...new Set(allMongos.map(x => x.service_name).filter(Boolean))];\n\nreturn [{\n  json: {\n    ...cfg,\n\n    selected_mongos: selectedMongos,\n    all_mongos_services: allMongos,\n    all_catalog_services: allServices,\n\n    selected_cluster_name:\n      `sharded cluster via ${selectedMongos.node_name}`,\n\n    selected_cluster_anchor:\n      selectedMongos.service_name,\n\n    all_mongos_service_regex:\n      `^(?:${allMongosNames.map(escapeRegex).join('|')})$`,\n\n    timezone: cfg.timezone\n  }\n}];"
      },
