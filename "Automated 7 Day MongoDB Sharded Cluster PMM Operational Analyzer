      "parameters": {
        "jsCode": "const cfg = $json;\n\nconst upExpr =\n  'max by (' +\n    'node_name,service_name,cl_role,cluster_role,cluster,' +\n    'rs_nm,replication_set,set,rs_state,state,environment' +\n  ') (' +\n    'mongodb_up{node_name!=\"\",service_name!=\"\"}' +\n  ')';\n\nconst stateExpr =\n  'max by (' +\n    'node_name,service_name,cl_role,cluster_role,cluster,' +\n    'rs_nm,replication_set,set,environment' +\n  ') (' +\n    'mongodb_mongod_replset_my_state{node_name!=\"\",service_name!=\"\"}' +\n  ')';\n\nfunction q(refId, expr, legendFormat) {\n  return {\n    expr,\n    format: 'time_series',\n    instant: true,\n    range: false,\n    legendFormat,\n    refId,\n    datasource: {\n      type: 'prometheus',\n      uid: cfg.prometheus_datasource_uid\n    },\n    datasourceId: Number(cfg.prometheus_datasource_id || 1),\n    intervalMs: Number(cfg.sampling_interval_ms || 300000),\n    maxDataPoints: 5000\n  };\n}\n\nreturn [{\n  json: {\n    ...cfg,\n    cluster_catalog_url:\n      `${String(cfg.pmm_base_url).replace(/\\/$/, '')}` +\n      '/graph/api/ds/query?ds_type=prometheus&requestId=MONGOMONGOSCATALOG',\n    cluster_catalog_body: {\n      queries: [\n        q(\n          'MONGO_UP',\n          upExpr,\n          '{{node_name}}|||{{service_name}}|||{{cl_role}}|||{{cluster_role}}|||{{cluster}}|||{{rs_nm}}|||{{replication_set}}|||{{set}}|||{{rs_state}}|||{{state}}|||{{environment}}'\n        ),\n        q(\n          'REPL_STATE',\n          stateExpr,\n          '{{node_name}}|||{{service_name}}|||{{cl_role}}|||{{cluster_role}}|||{{cluster}}|||{{rs_nm}}|||{{replication_set}}|||{{set}}|||{{environment}}'\n        )\n      ],\n      from: 'now-5m',\n      to: 'now'\n    }\n  }\n}];"
