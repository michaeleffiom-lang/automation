# Client configuration. Use clients.json for more than one PMM.
PMM_CLIENTS_FILE=clients.json
PMM_CLIENT_ID=local-pmm-8443
PMM_ADMIN_USERNAME=admin
PMM_ADMIN_PASSWORD=change-me
PMM_DISCOVERY_USERNAME=
PMM_DISCOVERY_PASSWORD=
PMM_DISCOVERY_TOKEN=
PMM_SERVICE_DISCOVERY_URL=https://127.0.0.1:8443/prometheus/service-discovery
PMM_API_BASE_URL=https://127.0.0.1:8443/v1
PMM_TLS_INSECURE=true
PMM_HTTP_TIMEOUT=10
PMM_CATALOG_TTL_SECONDS=86400
# Optional: PMM_CATALOG_CACHE_DIR=/var/lib/pmm-operations/catalog

# Local Docker MongoDB stack (optional for the MCP itself).
MONGO_ROOT_USERNAME=mcpadmin
MONGO_ROOT_PASSWORD=change-me
