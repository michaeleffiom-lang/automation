#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
base="$(git rev-parse --verify HEAD 2>/dev/null || printf '%040d' 0)"
# Compare the staged snapshot, so unstaged prompt changes cannot satisfy the check.
head_tree="$(git write-tree)"
python_bin="${PMM_PYTHON:-python3}"
"$python_bin" scripts/check_prompt_updated.py "$base" "$head_tree"
